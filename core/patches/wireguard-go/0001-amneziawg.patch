+func TestAWGClassify(t *testing.T) {
+	configs := map[string]string{
+		"awg1":     "s1=15\ns2=40\nh1=1020325451\nh2=3288052141\nh3=1766607858\nh4=2528465083",
+		"awg2":     "s1=15\ns2=40\ns3=20\ns4=10\nh1=100-200\nh2=300-400\nh3=500-600\nh4=700-800",
+		"awg3":     "s1=24\ns2=12\ns3=16\ns4=13\nh1=100-200\nh2=300-400\nh3=500-600\nh4=700-800\nheader_protection_key=" + randomKeyHex(t),
+		"awg3.1":   "s1=24\ns2=12\ns3=16\ns4=13\nh1=100-200\nh2=300-400\nh3=500-600\nh4=700-800\nheader_protection_key=" + randomKeyHex(t) + "\nrandom_trailers=1",
+		"trailers": "s1=15\ns2=40\ns3=20\ns4=10\nh1=100-200\nh2=300-400\nh3=500-600\nh4=700-800\nrandom_trailers=true",
+		"defaults": "jc=3",
+	}
+	for name, lines := range configs {
+		p := testAWGParams(t, lines)
+		for kind := awgInit; kind <= awgCookie; kind++ {
+			trailers := 0
+			for range 50 {
+				trailer := p.randomTrailer(awgUDPWindow, int(p.paddings[kind])+awgMessageSizes[kind])
+				if trailer > 0 {
+					trailers++
+				}
+				buffer, message := p.newMessageBuffer(kind, trailer)
+				if _, err := rand.Read(message); err != nil {
+					t.Fatal(err)
+				}
+				binary.LittleEndian.PutUint32(message, p.headers[kind].PickOne())
+				original := bytes.Clone(message)
+				p.protect(buffer, message)
+				if p.headerKey != nil && bytes.Equal(original[:4], message[:4]) && bytes.Equal(original[4:], message[4:]) {
+					t.Fatalf("%s: message %d is not protected", name, kind)
+				}
+				msgType, padding, length := p.classify(buffer[MessageEncapsulatingTransportSize:])
+				if msgType != awgMessageTypes[kind] || padding != int(p.paddings[kind]) || length != awgMessageSizes[kind] {
+					t.Fatalf("%s: message %d classified as %d with padding %d, length %d", name, kind, msgType, padding, length)
+				}
+				start := MessageEncapsulatingTransportSize + padding
+				if !bytes.Equal(buffer[start:start+length], original) {
+					t.Fatalf("%s: message %d is not restored", name, kind)
+				}
+			}
+			if p.randomTrailers != (trailers > 0) {
+				t.Fatalf("%s: %d of 50 messages %d with trailers", name, trailers, kind)
+			}
+		}
+
+		// transport message: the header protection covers its 16 bytes of header
+		for _, contentLength := range []int{0, 16, 48, 1420} {
+			padding := int(p.paddings[awgTransport])
+			packet := make([]byte, padding+MessageTransportSize+contentLength)
+			if _, err := rand.Read(packet); err != nil {
+				t.Fatal(err)
+			}
+			binary.LittleEndian.PutUint32(packet[padding:], p.headers[awgTransport].PickOne())
+			original := bytes.Clone(packet)
+			if cipher := p.headerCipher(packet); cipher != nil {
+				header := packet[padding : padding+MessageTransportHeaderSize]
+				cipher.XORKeyStream(header, header)
+			}
+			msgType, gotPadding, length := p.classify(packet)
+			if msgType != MessageTransportType || gotPadding != padding || length != len(packet)-padding {
+				t.Fatalf("%s: transport classified as %d with padding %d, length %d", name, msgType, gotPadding, length)
+			}
+			if !bytes.Equal(packet, original) {
+				t.Fatalf("%s: transport header is not restored", name)
+			}
+		}
+
+		// a datagram too short for a transport message
+		short := make([]byte, int(p.paddings[awgTransport])+MessageTransportSize-1)
+		binary.LittleEndian.PutUint32(short[p.paddings[awgTransport]:], p.headers[awgTransport].Lo())
+		if msgType, _, _ := p.classify(short); msgType != MessageUnknownType && p.headerKey == nil {
+			t.Fatalf("%s: short datagram classified as %d", name, msgType)
+		}
+	}
+
+	// without header protection, a datagram with an unknown type is junk
+	p := testAWGParams(t, configs["awg2"])
+	junk := make([]byte, 200)
+	binary.LittleEndian.PutUint32(junk[p.paddings[awgTransport]:], 50)
+	if msgType, _, _ := p.classify(junk); msgType != MessageUnknownType {
+		t.Fatalf("junk classified as %d", msgType)
+	}
+
+	// without random trailers, a handshake message with bytes after it is not one
+	buffer, message := p.newMessageBuffer(awgInit, 1)
+	binary.LittleEndian.PutUint32(message, p.headers[awgInit].Lo())
+	if msgType, _, _ := p.classify(buffer[MessageEncapsulatingTransportSize:]); msgType == MessageInitiationType {
+		t.Fatal("initiation with a trailer accepted without random trailers")
+	}
+}
+
+func TestAWGValidate(t *testing.T) {
+	for _, lines := range []string{
+		"h1=1-10\nh2=10-20",
+		"h4=1",
+		"jc=4\njmin=100\njmax=50",
+		"jc=4\njmin=10\njmax=65500",
+		"s1=11\ns2=20\ns3=20\ns4=20\nheader_protection_key=" + randomKeyHex(t),
+		"s4=0\ns1=20\ns2=20\ns3=20\nheader_protection_key=" + randomKeyHex(t),
+	} {
+		p := newAWGParams()
+		for _, line := range strings.Split(lines, "\n") {
+			key, value, _ := strings.Cut(line, "=")
+			if err := p.set(key, value); err != nil {
+				t.Fatalf("%s: %v", line, err)
+			}
+		}
+		if err := p.validate(); err == nil {
+			t.Fatalf("%q: no error", lines)
+		}
+	}
+	for _, line := range []string{
+		"jc=1001", "jc=-1", "s1=65536", "h1=5-1", "i1=<x>", "j1=<r", "itime=x",
+		"header_protection_key=00", "content_padding_addition=a", "max_handshake_attempts=2-1",
+		"random_trailers=2", "disable_cookies=yes",
+	} {
+		key, value, _ := strings.Cut(line, "=")
+		if err := newAWGParams().set(key, value); err == nil {
+			t.Fatalf("%q: no error", line)
+		}
+	}
+}
+
+func TestAWGContentPadding(t *testing.T) {
+	// content of 1300 bytes in a datagram of 1332 (S4 0)
+	p := testAWGParams(t, "content_padding_addition=0-100")
+	both := testAWGParams(t, "content_padding_addition=50-60\nrandom_trailers=1")
+	for range 1000 {
+		if size := p.contentPaddingSize(1500, 1332, 1300, 1420); size < 0 || size > 100 {
+			t.Fatalf("padding %d", size)
+		}
+		if size := p.contentPaddingSize(1352, 1332, 1300, 1420); size > 20 {
+			t.Fatalf("padding %d over the UDP window", size)
+		}
+		if size := both.contentPaddingSize(1500, 1332, 1300, 1420); size < 50 || size > 60 {
+			t.Fatalf("padding %d, want ContentPaddingAddition", size)
+		}
+	}
+	if size := p.contentPaddingSize(1000, 1332, 1300, 1420); size != 0 {
+		t.Fatalf("padding %d beyond the UDP window", size)
+	}
+
+	trailers := testAWGParams(t, "random_trailers=1")
+	seen := map[int]bool{}
+	for range 1000 {
+		size := trailers.contentPaddingSize(500, 100, 68, 1420)
+		if size < 0 || size >= 400 {
+			t.Fatalf("trailer %d", size)
+		}
+		seen[size] = true
+	}
+	if len(seen) < 100 {
+		t.Fatalf("trailers of %d sizes only", len(seen))
+	}
+	if size := trailers.contentPaddingSize(500, 600, 568, 1420); size != 0 {
+		t.Fatalf("trailer %d beyond the UDP window", size)
+	}
+
+	plain := testAWGParams(t, "s4=10")
+	if size := plain.contentPaddingSize(500, 59, 17, 1420); size != 15 {
+		t.Fatalf("padding %d, want 15", size)
+	}
+}
