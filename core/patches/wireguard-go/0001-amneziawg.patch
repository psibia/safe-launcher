--- /dev/null
+++ b/device/awg.go
@@ -0,0 +1,524 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ *
+ * AmneziaWG: WireGuard with obfuscated packets (junk and signature packets,
+ * message paddings and headers, header protection, custom timings).
+ * Ported from github.com/amnezia-vpn/amneziawg-go (MIT); wire compatible with
+ * its releases from v0.2.12 (AmneziaWG 1.0) to v3.1.20260828 (AmneziaWG 3.1),
+ * and with AmneziaWG 1.5 configurations (J1-J3, Itime).
+ */
+
+package device
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/crypto/chacha20"
+	"golang.org/x/crypto/chacha20poly1305"
+)
+
+const (
+	HeaderCipherKeySize   = 32
+	HeaderCipherNonceSize = 12
+)
+
+// HeaderCipherKey is the AmneziaWG header protection key.
+type HeaderCipherKey [HeaderCipherKeySize]byte
+
+func (key *HeaderCipherKey) FromHex(src string) error {
+	return loadExactHex(key[:], src)
+}
+
+func (key HeaderCipherKey) IsZero() bool {
+	var zero HeaderCipherKey
+	return key == zero
+}
+
+// UintRange is a closed range of uint32 values: lo in the low 32 bits, hi in
+// the high 32 bits. Zero means "not set".
+type UintRange uint64
+
+func (r *UintRange) FromUint32(lo, hi uint32) {
+	*r = UintRange(uint64(hi)<<32 | uint64(lo))
+}
+
+// FromString parses "a" or "a-b".
+func (r *UintRange) FromString(str string) error {
+	loText, hiText, isRange := strings.Cut(str, "-")
+	lo, err := strconv.ParseUint(strings.TrimSpace(loText), 10, 32)
+	if err != nil {
+		return err
+	}
+	hi := lo
+	if isRange {
+		hi, err = strconv.ParseUint(strings.TrimSpace(hiText), 10, 32)
+		if err != nil {
+			return err
+		}
+	}
+	if hi < lo {
+		return errors.New("wrong range specified")
+	}
+	r.FromUint32(uint32(lo), uint32(hi))
+	return nil
+}
+
+func (r UintRange) Lo() uint32 {
+	return uint32(r)
+}
+
+func (r UintRange) Hi() uint32 {
+	return uint32(r >> 32)
+}
+
+func (r UintRange) IsZero() bool {
+	return r == 0
+}
+
+func (r UintRange) Contains(num uint32) bool {
+	return r.Lo() <= num && num <= r.Hi()
+}
+
+func (r UintRange) Overlap(other UintRange) bool {
+	return r.Lo() <= other.Hi() && other.Lo() <= r.Hi()
+}
+
+// PickOne returns a random value of the range.
+func (r UintRange) PickOne() uint32 {
+	return r.Lo() + fastrandn(r.Hi()-r.Lo()+1)
+}
+
+func (r UintRange) String() string {
+	if r.Lo() == r.Hi() {
+		return strconv.FormatUint(uint64(r.Lo()), 10)
+	}
+	return strconv.FormatUint(uint64(r.Lo()), 10) + "-" + strconv.FormatUint(uint64(r.Hi()), 10)
+}
+
+type AtomicUintRange struct {
+	v atomic.Uint64
+}
+
+func (a *AtomicUintRange) Load() UintRange {
+	return UintRange(a.v.Load())
+}
+
+func (a *AtomicUintRange) Store(r UintRange) {
+	a.v.Store(uint64(r))
+}
+
+func (a *AtomicUintRange) Swap(r UintRange) UintRange {
+	return UintRange(a.v.Swap(uint64(r)))
+}
+
+// Message kinds: indexes of awgParams.headers and awgParams.paddings (H1-H4, S1-S4).
+const (
+	awgInit = iota
+	awgResponse
+	awgCookie
+	awgTransport
+)
+
+var (
+	awgMessageTypes = [4]uint32{MessageInitiationType, MessageResponseType, MessageCookieReplyType, MessageTransportType}
+	awgMessageSizes = [4]int{MessageInitiationSize, MessageResponseSize, MessageCookieReplySize, MessageTransportHeaderSize}
+)
+
+// maxPacketSize is the largest UDP payload over IPv4.
+const maxPacketSize = 65507
+
+// awgUDPWindow is the initial UDP window of a peer (AmneziaWG 3.1): its largest
+// datagram, which bounds random trailers and content padding.
+const awgUDPWindow = 500
+
+// awgParams is an immutable snapshot of the AmneziaWG settings of a device.
+// Device.awg is nil for plain WireGuard: then every code path is the original one.
+type awgParams struct {
+	junkCount uint32 // Jc
+	junkMin   uint32 // Jmin
+	junkMax   uint32 // Jmax
+
+	headers  [4]UintRange // H1-H4: message types
+	paddings [4]uint32    // S1-S4: random bytes before the message
+
+	ipackets [5]*obfChain // I1-I5: signature packets
+	jpackets [3]*obfChain // J1-J3: AmneziaWG 1.5, sent instead of I1-I5 until Itime passes
+	itime    uint32       // Itime, seconds: AmneziaWG 1.5
+
+	headerKey      *HeaderCipherKey // header protection, nil if off
+	contentPadding UintRange        // random padding of transport content instead of padding to 16 bytes
+	randomTrailers bool             // AmneziaWG 3.1: random bytes after handshake messages, random padding of transport content
+	disableCookies bool             // AmneziaWG 3.1: no cookie replies (and no rate limit) under load
+
+	rekeyAfterTime       UintRange // seconds
+	rekeyTimeout         UintRange // seconds
+	rejectAfterTime      UintRange // seconds
+	keepaliveTimeout     UintRange // seconds
+	maxHandshakeAttempts UintRange
+}
+
+func newAWGParams() *awgParams {
+	p := new(awgParams)
+	for kind, msgType := range awgMessageTypes {
+		p.headers[kind].FromUint32(msgType, msgType)
+	}
+	return p
+}
+
+func (p *awgParams) clone() *awgParams {
+	c := *p
+	if p.headerKey != nil {
+		key := *p.headerKey
+		c.headerKey = &key
+	}
+	return &c
+}
+
+func (p *awgParams) validate() error {
+	if p.junkCount > 0 {
+		if p.junkMax < p.junkMin {
+			return fmt.Errorf("jmax %d is less than jmin %d", p.junkMax, p.junkMin)
+		}
+		if p.junkMax > maxPacketSize-MessageEncapsulatingTransportSize {
+			return fmt.Errorf("jmax %d is too large", p.junkMax)
+		}
+	}
+	for kind, padding := range p.paddings {
+		if int(padding)+awgMessageSizes[kind]+MessageTransportSize > maxPacketSize {
+			return fmt.Errorf("s%d %d is too large", kind+1, padding)
+		}
+		if p.headerKey != nil && padding < HeaderCipherNonceSize {
+			return fmt.Errorf("s%d must be at least %d to use header protection", kind+1, HeaderCipherNonceSize)
+		}
+	}
+	for i := range p.headers {
+		for j := i + 1; j < len(p.headers); j++ {
+			if p.headers[i].Overlap(p.headers[j]) {
+				return fmt.Errorf("h%d and h%d overlap", i+1, j+1)
+			}
+		}
+	}
+	return nil
+}
+
+// headerCipher is the header protection keystream for a message whose padding
+// starts with nonce; nil if header protection is off.
+func (p *awgParams) headerCipher(nonce []byte) *chacha20.Cipher {
+	if p.headerKey == nil || len(nonce) < HeaderCipherNonceSize {
+		return nil
+	}
+	cipher, err := chacha20.NewUnauthenticatedCipher(p.headerKey[:], nonce[:HeaderCipherNonceSize])
+	if err != nil {
+		return nil
+	}
+	return cipher
+}
+
+// classify finds what a received datagram is, as amneziawg-go does: by its size
+// (S1-S4 plus the message size, or more with random trailers) and type (H1-H4).
+// With header protection it unmasks the header in place. It returns the message
+// type, the padding to skip and the length of the message after it (handshake
+// messages without their trailer), or MessageUnknownType for junk, signature
+// packets and garbage.
+func (p *awgParams) classify(packet []byte) (uint32, int, int) {
+	var mask [4]byte
+	cipher := p.headerCipher(packet)
+	if p.headerKey != nil {
+		if cipher == nil {
+			return MessageUnknownType, 0, 0
+		}
+		cipher.XORKeyStream(mask[:], mask[:])
+	}
+	size := len(packet)
+	for kind := awgInit; kind <= awgTransport; kind++ {
+		padding := int(p.paddings[kind])
+		length := awgMessageSizes[kind]
+		if kind == awgTransport {
+			if size < padding+MessageTransportSize {
+				continue
+			}
+			length = size - padding
+		} else if size != padding+length && !(p.randomTrailers && size > padding+length) {
+			continue
+		}
+		msgType := binary.LittleEndian.Uint32(packet[padding:]) ^ binary.LittleEndian.Uint32(mask[:])
+		if !p.headers[kind].Contains(msgType) {
+			continue
+		}
+		if cipher != nil {
+			binary.LittleEndian.PutUint32(packet[padding:], msgType)
+			end := padding + length
+			if kind == awgTransport {
+				end = padding + MessageTransportHeaderSize
+			}
+			cipher.XORKeyStream(packet[padding+4:end], packet[padding+4:end])
+		}
+		return awgMessageTypes[kind], padding, length
+	}
+	return MessageUnknownType, 0, 0
+}
+
+// newMessageBuffer returns a buffer for a handshake message of the given kind:
+// MessageEncapsulatingTransportSize free bytes, the padding, the message and
+// trailer bytes (none if trailer < 1). The padding and the trailer are random;
+// the message is also returned separately for the caller to fill.
+func (p *awgParams) newMessageBuffer(kind int, trailer int) (buffer []byte, message []byte) {
+	start := MessageEncapsulatingTransportSize + int(p.paddings[kind])
+	end := start + awgMessageSizes[kind]
+	buffer = make([]byte, end+max(trailer, 0))
+	_, _ = rand.Read(buffer[MessageEncapsulatingTransportSize:start])
+	_, _ = rand.Read(buffer[end:])
+	return buffer, buffer[start:end]
+}
+
+// randomTrailer is how many random bytes follow a datagram of size bytes
+// (AmneziaWG 3.1 RandomTrailers): up to the UDP window, or -1 if trailers are off.
+func (p *awgParams) randomTrailer(window uint32, size int) int {
+	if !p.randomTrailers {
+		return -1
+	}
+	if int(window) < size {
+		return 0
+	}
+	return int(fastrandn(window - uint32(size)))
+}
+
+// protect applies header protection to a filled message of newMessageBuffer.
+func (p *awgParams) protect(buffer []byte, message []byte) {
+	cipher := p.headerCipher(buffer[MessageEncapsulatingTransportSize:])
+	if cipher != nil {
+		cipher.XORKeyStream(message, message)
+	}
+}
+
+// transportPadding is S4: how many random bytes precede a transport message.
+func (device *Device) transportPadding() uint32 {
+	if p := device.awg.Load(); p != nil {
+		return p.paddings[awgTransport]
+	}
+	return 0
+}
+
+// prefixPackets returns the datagrams sent before a handshake initiation: the
+// signature packets I1-I5 (or, with an AmneziaWG 1.5 Itime, J1-J3 until it
+// passes) and Jc junk packets. Each starts after MessageEncapsulatingTransportSize
+// free bytes.
+func (device *Device) prefixPackets(p *awgParams) [][]byte {
+	var packets [][]byte
+	chains := p.jpackets[:]
+	if p.hasSignaturePackets() {
+		device.awgSignature.Lock()
+		now := time.Now()
+		if !device.awgSignature.sent || !now.Before(device.awgSignature.next) {
+			chains = p.ipackets[:]
+			device.awgSignature.sent = true
+			device.awgSignature.next = now.Add(time.Duration(p.itime) * time.Second)
+		}
+		device.awgSignature.Unlock()
+	}
+	for _, chain := range chains {
+		if chain == nil {
+			continue
+		}
+		packet := make([]byte, MessageEncapsulatingTransportSize+chain.ObfuscatedLen(0))
+		chain.Obfuscate(packet[MessageEncapsulatingTransportSize:], nil)
+		packets = append(packets, packet)
+	}
+	for range p.junkCount {
+		size := p.junkMin
+		if p.junkMax > p.junkMin {
+			size += fastrandn(p.junkMax - p.junkMin)
+		}
+		packet := make([]byte, MessageEncapsulatingTransportSize+int(size))
+		_, _ = rand.Read(packet[MessageEncapsulatingTransportSize:])
+		packets = append(packets, packet)
+	}
+	return packets
+}
+
+func (p *awgParams) hasSignaturePackets() bool {
+	for _, chain := range p.ipackets {
+		if chain != nil {
+			return true
+		}
+	}
+	return false
+}
+
+// contentPaddingSize is how many zero bytes follow transport content of
+// contentSize bytes in a datagram of packetSize bytes, as amneziawg-go 3.1 pads:
+// a random ContentPaddingAddition or, with RandomTrailers, a random size, both
+// within the UDP window of the peer; otherwise the WireGuard padding to a
+// multiple of 16.
+func (p *awgParams) contentPaddingSize(window uint32, packetSize, contentSize, mtu int) int {
+	if !p.contentPadding.IsZero() {
+		if int(window) < packetSize {
+			return 0
+		}
+		return min(int(p.contentPadding.PickOne()), int(window)-packetSize)
+	}
+	if trailer := p.randomTrailer(window, packetSize); trailer >= 0 {
+		return trailer
+	}
+	return calculatePaddingSize(contentSize, mtu)
+}
+
+// raiseUDPWindow makes the UDP window of the peer at least size and returns it.
+func (peer *Peer) raiseUDPWindow(size uint32) uint32 {
+	for {
+		window := peer.udpWindow.Load()
+		if window >= size {
+			return window
+		}
+		if peer.udpWindow.CompareAndSwap(window, size) {
+			return size
+		}
+	}
+}
+
+// cookiesDisabled is AmneziaWG 3.1 DisableCookies.
+func (device *Device) cookiesDisabled() bool {
+	p := device.awg.Load()
+	return p != nil && p.disableCookies
+}
+
+// sealAWG encrypts elem into an AmneziaWG transport message in place: S4
+// random bytes, the header with an H4 type, the content and its padding,
+// then header protection. The plaintext is at
+// MessageEncapsulatingTransportSize+elem.padding+MessageTransportHeaderSize.
+func (device *Device) sealAWG(p *awgParams, elem *QueueOutboundElement, nonce *[chacha20poly1305.NonceSize]byte) {
+	if padding := p.paddings[awgTransport]; elem.padding != padding {
+		// S4 was set after the packet was placed, as when the TUN reader
+		// waited for it from before the configuration: move the packet
+		from := MessageEncapsulatingTransportSize + int(elem.padding) + MessageTransportHeaderSize
+		to := MessageEncapsulatingTransportSize + int(padding) + MessageTransportHeaderSize
+		size := len(elem.packet)
+		if to+size+chacha20poly1305.Overhead > cap(elem.buffer) {
+			// no room: the packet is lost, a keepalive goes instead
+			size = 0
+			elem.keepalive = true
+		}
+		copy(elem.buffer[to:to+size], elem.buffer[from:from+size])
+		elem.packet = elem.buffer[to : to+size]
+		elem.padding = padding
+	}
+	start := MessageEncapsulatingTransportSize + int(elem.padding)
+	contentStart := start + MessageTransportHeaderSize
+	_, _ = rand.Read(elem.buffer[MessageEncapsulatingTransportSize:start])
+
+	header := elem.buffer[start:contentStart]
+	binary.LittleEndian.PutUint32(header[0:4], p.headers[awgTransport].PickOne())
+	binary.LittleEndian.PutUint32(header[4:8], elem.keypair.remoteIndex)
+	binary.LittleEndian.PutUint64(header[8:16], elem.nonce)
+
+	size := len(elem.packet)
+	packetSize := int(elem.padding) + MessageTransportSize + size
+	window := elem.peer.raiseUDPWindow(uint32(packetSize))
+	space := cap(elem.buffer) - contentStart - size - chacha20poly1305.Overhead
+	paddingSize := max(0, min(p.contentPaddingSize(window, packetSize, size, int(device.tun.mtu.Load())), space))
+	content := elem.buffer[contentStart : contentStart+size+paddingSize]
+	clear(content[size:])
+
+	binary.LittleEndian.PutUint64(nonce[4:], elem.nonce)
+	sealed := elem.keypair.send.Seal(header, nonce[:], content, nil)
+	elem.packet = elem.buffer[:start+len(sealed)]
+
+	if cipher := p.headerCipher(elem.buffer[MessageEncapsulatingTransportSize:start]); cipher != nil {
+		cipher.XORKeyStream(header, header)
+	}
+}
+
+// inputPacketLength returns the S4 padding and the buffer size for an injected
+// packet of n bytes (InputPacket, InputPackets); the size is over
+// MaxMessageSize if the packet does not fit.
+func (device *Device) inputPacketLength(n int) (uint32, int) {
+	length := MessageEncapsulatingTransportSize + MessageTransportHeaderSize + n + PaddingMultiple + chacha20poly1305.Overhead
+	p := device.awg.Load()
+	if p == nil {
+		return 0, length
+	}
+	padding := p.paddings[awgTransport]
+	length += int(padding)
+	if length <= MaxMessageSize && (!p.contentPadding.IsZero() || p.randomTrailers) {
+		// room for the random padding, which stays within the UDP window of the
+		// peer: its largest datagram, in practice a full one
+		window := max(awgUDPWindow, int(device.tun.mtu.Load())+MessageTransportSize+int(padding))
+		length = min(max(length, MessageEncapsulatingTransportSize+window), MaxMessageSize)
+	}
+	return padding, length
+}
+
+// Timings: the WireGuard constants unless AmneziaWG sets them.
+
+// plainParams has no timings set: the WireGuard constants.
+var plainParams awgParams
+
+func (device *Device) timingParams() *awgParams {
+	if p := device.awg.Load(); p != nil {
+		return p
+	}
+	return &plainParams
+}
+
+// timing is r seconds (pick chooses a value of the range), or def if r is not set.
+func timing(r UintRange, pick func(UintRange) uint32, def time.Duration) time.Duration {
+	if r.IsZero() {
+		return def
+	}
+	return time.Duration(pick(r)) * time.Second
+}
+
+// retransmitHandshakeTimeout replaces RekeyTimeout for handshake retransmission.
+func (device *Device) retransmitHandshakeTimeout() time.Duration {
+	return timing(device.timingParams().rekeyTimeout, UintRange.PickOne, RekeyTimeout)
+}
+
+// rekeyMinTimeout replaces RekeyTimeout as the minimum time between handshake initiations.
+func (device *Device) rekeyMinTimeout() time.Duration {
+	return timing(device.timingParams().rekeyTimeout, UintRange.Lo, RekeyTimeout)
+}
+
+// sendKeepaliveTimeout replaces KeepaliveTimeout for passive keepalives.
+func (device *Device) sendKeepaliveTimeout() time.Duration {
+	return timing(device.timingParams().keepaliveTimeout, UintRange.PickOne, KeepaliveTimeout)
+}
+
+// newHandshakeTimeout replaces KeepaliveTimeout + RekeyTimeout.
+func (device *Device) newHandshakeTimeout() time.Duration {
+	p := device.timingParams()
+	return timing(p.keepaliveTimeout, UintRange.Hi, KeepaliveTimeout) + timing(p.rekeyTimeout, UintRange.PickOne, RekeyTimeout)
+}
+
+// keyRefreshTimeoutSending replaces RekeyAfterTime.
+func (device *Device) keyRefreshTimeoutSending() time.Duration {
+	return timing(device.timingParams().rekeyAfterTime, UintRange.PickOne, RekeyAfterTime)
+}
+
+// keyRefreshTimeoutReceiving replaces RejectAfterTime - KeepaliveTimeout - RekeyTimeout.
+func (device *Device) keyRefreshTimeoutReceiving() time.Duration {
+	p := device.timingParams()
+	return max(0, timing(p.rejectAfterTime, UintRange.PickOne, RejectAfterTime)-
+		timing(p.keepaliveTimeout, UintRange.Lo, KeepaliveTimeout)-
+		timing(p.rekeyTimeout, UintRange.Lo, RekeyTimeout))
+}
+
+// keychainExpireTime replaces RejectAfterTime.
+func (device *Device) keychainExpireTime() time.Duration {
+	return timing(device.timingParams().rejectAfterTime, UintRange.Hi, RejectAfterTime)
+}
+
+// maxHandshakeAttempts replaces MaxTimerHandshakes.
+func (device *Device) maxHandshakeAttempts() uint32 {
+	if r := device.timingParams().maxHandshakeAttempts; !r.IsZero() {
+		return r.PickOne()
+	}
+	return MaxTimerHandshakes
+}
