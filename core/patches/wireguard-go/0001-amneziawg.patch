+func testAWGParams(t *testing.T, lines string) *awgParams {
+	t.Helper()
+	p := newAWGParams()
+	for _, line := range strings.Split(lines, "\n") {
+		key, value, _ := strings.Cut(line, "=")
+		if err := p.set(key, value); err != nil {
+			t.Fatalf("%s: %v", line, err)
+		}
+	}
+	if err := p.validate(); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
