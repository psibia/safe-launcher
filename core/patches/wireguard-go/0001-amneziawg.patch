+func TestUintRange(t *testing.T) {
+	for _, test := range []struct {
+		text   string
+		lo, hi uint32
+		ok     bool
+	}{
+		{"5", 5, 5, true},
+		{"5-10", 5, 10, true},
+		{" 5 - 10 ", 5, 10, true},
+		{"0", 0, 0, true},
+		{"4294967295", 4294967295, 4294967295, true},
+		{"10-5", 0, 0, false},
+		{"4294967296", 0, 0, false},
+		{"-5", 0, 0, false},
+		{"5-", 0, 0, false},
+		{"a", 0, 0, false},
+		{"", 0, 0, false},
+		{"1-2-3", 0, 0, false},
+	} {
+		var r UintRange
+		err := r.FromString(test.text)
+		if (err == nil) != test.ok {
+			t.Fatalf("%q: error %v, want ok=%v", test.text, err, test.ok)
+		}
+		if !test.ok {
+			continue
+		}
+		if r.Lo() != test.lo || r.Hi() != test.hi {
+			t.Fatalf("%q: got %d-%d", test.text, r.Lo(), r.Hi())
+		}
+		var again UintRange
+		if err := again.FromString(r.String()); err != nil || again != r {
+			t.Fatalf("%q: String %q does not parse back", test.text, r.String())
+		}
+	}
+
+	var r UintRange
+	r.FromUint32(10, 12)
+	seen := map[uint32]bool{}
+	for range 1000 {
+		value := r.PickOne()
+		if !r.Contains(value) {
+			t.Fatalf("PickOne %d is out of %s", value, r)
+		}
+		seen[value] = true
+	}
+	if len(seen) != 3 {
+		t.Fatalf("PickOne of %s gave %v", r, seen)
+	}
+	var other UintRange
+	other.FromUint32(12, 20)
+	if !r.Overlap(other) || !other.Overlap(r) {
+		t.Fatal("10-12 and 12-20 overlap")
+	}
+	other.FromUint32(13, 20)
+	if r.Overlap(other) || other.Overlap(r) {
+		t.Fatal("10-12 and 13-20 do not overlap")
+	}
+}
+
+func TestObfChain(t *testing.T) {
+	for _, spec := range []string{"", "no tags here"} {
+		chain, err := newObfChain(spec)
+		if chain != nil || err != nil {
+			t.Fatalf("%q: got %v, %v", spec, chain, err)
+		}
+	}
+
+	for _, test := range []struct {
+		spec   string
+		length int
+		check  func(packet []byte) bool
+	}{
+		{"<b 0xdeadbeef>", 4, func(p []byte) bool { return bytes.Equal(p, []byte{0xde, 0xad, 0xbe, 0xef}) }},
+		{"<b 0Xabc>", 2, func(p []byte) bool { return bytes.Equal(p, []byte{0x0a, 0xbc}) }},
+		{"<b c0ffee>", 3, func(p []byte) bool { return bytes.Equal(p, []byte{0xc0, 0xff, 0xee}) }},
+		{"<r 10>", 10, nil},
+		{"<rc 64>", 64, func(p []byte) bool { return strings.Trim(string(p), chars52) == "" }},
+		{"<rd 64>", 64, func(p []byte) bool { return strings.Trim(string(p), digits10) == "" }},
+		{"<t>", 4, nil},
+		{"<c>", 8, nil},
+		{"<wt 100>", 0, nil},
+		{"<B 0x01><R 2><T>", 7, func(p []byte) bool { return p[0] == 1 }},
+		{"x<b 0x01>y<b 0x02>z", 2, func(p []byte) bool { return bytes.Equal(p, []byte{1, 2}) }},
+		{"<r 0>", 0, nil},
+	} {
+		chain, err := newObfChain(test.spec)
+		if err != nil {
+			t.Fatalf("%q: %v", test.spec, err)
+		}
+		if chain == nil || chain.Spec != test.spec {
+			t.Fatalf("%q: got chain %v", test.spec, chain)
+		}
+		if length := chain.ObfuscatedLen(0); length != test.length {
+			t.Fatalf("%q: length %d, want %d", test.spec, length, test.length)
+		}
+		packet := make([]byte, test.length)
+		chain.Obfuscate(packet, nil)
+		if test.check != nil && !test.check(packet) {
+			t.Fatalf("%q: wrong packet %x", test.spec, packet)
+		}
+	}
+
+	for _, spec := range []string{
+		"<x>", "<b>", "<b 0xzz>", "<r -1>", "<r 70000>", "<r>", "<r 16", "<>",
+		"<wt 6000>", "<wt>", "<c 1>", "<r 65507>", "<r 40000><r 40000>",
+	} {
+		if chain, err := newObfChain(spec); err == nil {
+			t.Fatalf("%q: no error, chain %v", spec, chain)
+		}
+	}
+
+	// <d>, <ds>, <dz> wrap data, which signature packets do not have
+	chain, err := newObfChain("<dz 2><d><ds>")
+	if err != nil {
+		t.Fatal(err)
+	}
+	data := []byte("hello")
+	packet := make([]byte, chain.ObfuscatedLen(len(data)))
+	chain.Obfuscate(packet, data)
+	if want := "\x00\x05helloaGVsbG8"; string(packet) != want {
+		t.Fatalf("got %q, want %q", packet, want)
+	}
+
+	counter, _ := newObfChain("<c>")
+	first := make([]byte, 8)
+	second := make([]byte, 8)
+	counter.Obfuscate(first, nil)
+	counter.Obfuscate(second, nil)
+	if binary.BigEndian.Uint64(second) != binary.BigEndian.Uint64(first)+1 {
+		t.Fatalf("counter went %x, %x", first, second)
+	}
+}
