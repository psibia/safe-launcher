new file mode 100644
index 0000000..191ecfc
--- /dev/null
+++ b/device/awg_tunnel_test.go
@@ -0,0 +1,347 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ */
+
+package device_test
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/wireguard-go/conn"
+	"github.com/sagernet/wireguard-go/device"
+	"github.com/sagernet/wireguard-go/tun"
+)
+
+// TestAWGTunnel runs two devices over localhost UDP with AmneziaWG settings of each
+// generation and checks that packets of every size get through both ways, through
+// the TUN and through InputPacket, and that mismatched settings do not connect.
+func TestAWGTunnel(t *testing.T) {
+	headerKey := make([]byte, 32)
+	if _, err := rand.Read(headerKey); err != nil {
+		t.Fatal(err)
+	}
+	shared := map[string]string{
+		"plain":     "",
+		"junk-only": "jc=5\njmin=10\njmax=50",
+		"awg1.0":    "jc=4\njmin=40\njmax=70\ns1=15\ns2=40\nh1=1020325451\nh2=3288052141\nh3=1766607858\nh4=2528465083",
+		"awg1.5":    "jc=4\njmin=40\njmax=70\ns1=15\ns2=40\ns3=21\ns4=7\nh1=1020325451\nh2=3288052141\nh3=1766607858\nh4=2528465083",
+		"awg2.0":    "jc=4\njmin=40\njmax=70\ns1=15\ns2=40\ns3=21\ns4=7\nh1=100000-200000\nh2=300000-400000\nh3=500000-600000\nh4=700000-800000",
+		"awg3":      "s1=24\ns2=12\ns3=16\ns4=13\nh1=100000-200000\nh2=300000-400000\nh3=500000-600000\nh4=700000-800000\nheader_protection_key=" + hex.EncodeToString(headerKey),
+		"awg3.1":    "s1=24\ns2=12\ns3=16\ns4=13\nh1=100000-200000\nh2=300000-400000\nh3=500000-600000\nh4=700000-800000\nheader_protection_key=" + hex.EncodeToString(headerKey) + "\nrandom_trailers=1",
+	}
+	clientOnly := map[string]string{
+		"awg1.5": "i1=<b 0xc70000000108><r 16><t>\ni2=<rc 10>\ni3=<rd 4>\nj1=<r 30>\nitime=120",
+		"awg2.0": "i1=<b 0x0102><r 100>\ni5=<t><c>",
+		"awg3":   "jc=6\njmin=10\njmax=1000\ni1=<b 0xff><r 30>\ncontent_padding_addition=0-64\nrekey_after_time=100-110\nrekey_timeout=4-6\nreject_after_time=170-180\nkeepalive_timeout=8-12\nmax_handshake_attempts=10-20",
+		// the server pads with random trailers, the client with ContentPaddingAddition
+		"awg3.1": "jc=3\njmin=10\njmax=100\ni1=<b 0xff><r 30>\ncontent_padding_addition=0-64\ndisable_cookies=1",
+	}
+	for name, sharedLines := range shared {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			client, server := startAWGPair(t, sharedLines+"\n"+clientOnly[name], sharedLines)
+			checkAWGTraffic(t, client, server)
+		})
+	}
+
+	t.Run("mismatch", func(t *testing.T) {
+		t.Parallel()
+		client, server := startAWGPair(t, shared["awg2.0"], strings.Replace(shared["awg2.0"], "h4=700000-800000", "h4=900000-900100", 1))
+		client.tun.inbound <- testIPv4Packet("10.0.0.2", "10.0.0.1", []byte("lost"))
+		select {
+		case packet := <-server.tun.outbound:
+			t.Fatalf("a packet got through mismatched settings: %x", packet)
+		case <-time.After(2 * time.Second):
+		}
+	})
+
+	t.Run("plain-to-awg", func(t *testing.T) {
+		t.Parallel()
+		client, server := startAWGPair(t, "", shared["awg1.0"])
+		client.tun.inbound <- testIPv4Packet("10.0.0.2", "10.0.0.1", []byte("lost"))
+		select {
+		case packet := <-server.tun.outbound:
+			t.Fatalf("a packet got through mismatched settings: %x", packet)
+		case <-time.After(2 * time.Second):
+		}
+	})
+}
+
+type awgTestDevice struct {
+	*device.Device
+	tun *awgTestTUN
+}
+
+func startAWGPair(t *testing.T, clientAWG string, serverAWG string) (client *awgTestDevice, server *awgTestDevice) {
+	serverPrivate, serverPublic := generateTestKeyPair(t)
+	clientPrivate, clientPublic := generateTestKeyPair(t)
+	serverPort := freeUDPPort(t)
+	server = startAWGDevice(t, "server", serverPrivate+"\nlisten_port="+fmt.Sprint(serverPort), serverAWG,
+		"public_key="+clientPublic+"\nallowed_ip=10.0.0.2/32")
+	client = startAWGDevice(t, "client", clientPrivate, clientAWG,
+		"public_key="+serverPublic+"\nendpoint=127.0.0.1:"+fmt.Sprint(serverPort)+"\nallowed_ip=10.0.0.1/32")
+	return client, server
+}
+
+func startAWGDevice(t *testing.T, name string, private string, awg string, peer string) *awgTestDevice {
+	return startAWGDeviceWithLog(t, name, private, awg, peer, nil)
+}
+
+// startAWGDeviceWithLog also passes the verbose log lines of the device to logf.
+func startAWGDeviceWithLog(t *testing.T, name string, private string, awg string, peer string, logf func(line string)) *awgTestDevice {
+	tunDevice := &awgTestTUN{
+		name:     name,
+		inbound:  make(chan []byte, 64),
+		outbound: make(chan []byte, 1024),
+		events:   make(chan tun.Event, 1),
+		done:     make(chan struct{}),
+		reading:  make(chan struct{}),
+	}
+	logger := &device.Logger{
+		Verbosef: func(format string, args ...any) {
+			if logf != nil {
+				logf(fmt.Sprintf(format, args...))
+			}
+			if os.Getenv("AWG_TEST_VERBOSE") != "" {
+				t.Logf(name+": "+format, args...)
+			}
+		},
+		Errorf: func(format string, args ...any) {
+			t.Logf(name+": "+format, args...)
+		},
+	}
+	wgDevice := device.NewDevice(context.Background(), tunDevice, conn.NewStdNetBind(nil), logger, 0)
+	t.Cleanup(wgDevice.Close)
+	// The TUN reader places its next packet before the configuration sets S4,
+	// as it can in sing-box: the packet has to move.
+	<-tunDevice.reading
+	var lines []string
+	for _, line := range strings.Split("private_key="+private+"\n"+awg+"\n"+peer, "\n") {
+		if line != "" {
+			lines = append(lines, line)
+		}
+	}
+	if err := wgDevice.IpcSet(strings.Join(lines, "\n")); err != nil {
+		t.Fatal(err)
+	}
+	if err := wgDevice.Up(); err != nil {
+		t.Fatal(err)
+	}
+	return &awgTestDevice{Device: wgDevice, tun: tunDevice}
+}
+
+func checkAWGTraffic(t *testing.T, client *awgTestDevice, server *awgTestDevice) {
+	for _, size := range []int{0, 1, 15, 16, 17, 100, 500, 1000, 1380} {
+		payload := make([]byte, size)
+		if _, err := rand.Read(payload); err != nil {
+			t.Fatal(err)
+		}
+		request := testIPv4Packet("10.0.0.2", "10.0.0.1", payload)
+		client.tun.inbound <- request
+		expectPacket(t, server.tun, request)
+
+		reply := testIPv4Packet("10.0.0.1", "10.0.0.2", payload)
+		server.tun.inbound <- reply
+		expectPacket(t, client.tun, reply)
+
+		injected := testIPv4Packet("10.0.0.2", "10.0.0.1", append([]byte("injected"), payload...))
+		half := len(injected) / 2
+		client.InputPacket(netip.MustParseAddr("10.0.0.1").AsSlice(), [][]byte{injected[:half], injected[half:]})
+		expectPacket(t, server.tun, injected)
+	}
+	config, err := client.IpcGet()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(config, "last_handshake_time_sec=0\n") {
+		t.Fatal("no handshake: ", config)
+	}
+}
+
+func expectPacket(t *testing.T, tunDevice *awgTestTUN, want []byte) {
+	t.Helper()
+	select {
+	case got := <-tunDevice.outbound:
+		if !bytes.Equal(got, want) {
+			t.Fatalf("%s got %x, want %x", tunDevice.name, got, want)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatalf("%s got nothing", tunDevice.name)
+	}
+}
+
+func testIPv4Packet(source string, destination string, payload []byte) []byte {
+	packet := make([]byte, 28+len(payload))
+	packet[0] = 4<<4 | 5
+	binary.BigEndian.PutUint16(packet[2:], uint16(len(packet)))
+	packet[8] = 64
+	packet[9] = 17
+	copy(packet[12:16], netip.MustParseAddr(source).AsSlice())
+	copy(packet[16:20], netip.MustParseAddr(destination).AsSlice())
+	binary.BigEndian.PutUint16(packet[20:], 1000)
+	binary.BigEndian.PutUint16(packet[22:], 1001)
+	binary.BigEndian.PutUint16(packet[24:], uint16(8+len(payload)))
+	copy(packet[28:], payload)
+	return packet
+}
+
+func freeUDPPort(t *testing.T) int {
+	udpConn, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer udpConn.Close()
+	return udpConn.LocalAddr().(*net.UDPAddr).Port
+}
+
+// TestAWGIpc checks that AmneziaWG keys are read and reported by the configuration protocol.
+func TestAWGIpc(t *testing.T) {
+	private, _ := generateTestKeyPair(t)
+	headerKey := make([]byte, 32)
+	if _, err := rand.Read(headerKey); err != nil {
+		t.Fatal(err)
+	}
+	headerKeyHex := hex.EncodeToString(headerKey)
+	awg := "jc=4\njmin=40\njmax=70\ns1=15\ns2=40\ns3=21\ns4=13\nh1=100-200\nh2=300\nh3=400-500\nh4=600-700\n" +
+		"i1=<b 0x01><r 4>\nj2=<t>\nitime=60\nheader_protection_key=" + headerKeyHex + "\n" +
+		"content_padding_addition=0-16\nrekey_after_time=100\nrekey_timeout=4-6\nreject_after_time=170-180\n" +
+		"keepalive_timeout=8-12\nmax_handshake_attempts=10-20\nrandom_trailers=1\ndisable_cookies=1"
+	wgDevice := startAWGDevice(t, "ipc", private, awg, "public_key="+hex.EncodeToString(make([]byte, 31))+"01\nallowed_ip=10.0.0.9/32\npersistent_keepalive_interval=20-30")
+	config, err := wgDevice.IpcGet()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range append(strings.Split(awg, "\n"), "persistent_keepalive_interval=20-30") {
+		if !strings.Contains(config, line+"\n") {
+			t.Fatalf("missing %q in\n%s", line, config)
+		}
+	}
+
+	for _, bad := range []string{"h1=1-10\nh2=5", "jc=5\njmin=10\njmax=5", "s4=4\nheader_protection_key=" + headerKeyHex, "i1=<q>"} {
+		other := startAWGDevice(t, "bad", private, "", "")
+		if err := other.IpcSet(bad); err == nil {
+			t.Fatalf("%q: no error", bad)
+		}
+		otherConfig, _ := other.IpcGet()
+		if strings.Contains(otherConfig, "h1=") {
+			t.Fatalf("%q: settings applied in part:\n%s", bad, otherConfig)
+		}
+	}
+}
+
+// TestAWGPaddedKeepalive checks that keepalives padded with ContentPaddingAddition
+// (AmneziaWG 3) are taken as keepalives, not as packets with a wrong IP version.
+func TestAWGPaddedKeepalive(t *testing.T) {
+	serverPrivate, serverPublic := generateTestKeyPair(t)
+	clientPrivate, clientPublic := generateTestKeyPair(t)
+	serverPort := freeUDPPort(t)
+	var access sync.Mutex
+	var keepalives, invalid int
+	logf := func(line string) {
+		access.Lock()
+		defer access.Unlock()
+		if strings.Contains(line, "Receiving keepalive packet") {
+			keepalives++
+		}
+		if strings.Contains(line, "invalid IP version") {
+			invalid++
+		}
+	}
+	shared := "s4=13\nh4=700-800\nrandom_trailers=1"
+	startAWGDeviceWithLog(t, "server", serverPrivate+"\nlisten_port="+fmt.Sprint(serverPort), shared,
+		"public_key="+clientPublic+"\nallowed_ip=10.0.0.2/32", logf)
+	startAWGDevice(t, "client", clientPrivate, shared+"\ncontent_padding_addition=16-64",
+		"public_key="+serverPublic+"\nendpoint=127.0.0.1:"+fmt.Sprint(serverPort)+"\nallowed_ip=10.0.0.1/32\npersistent_keepalive_interval=1")
+	for deadline := time.Now().Add(10 * time.Second); time.Now().Before(deadline); time.Sleep(100 * time.Millisecond) {
+		access.Lock()
+		done := keepalives >= 3
+		access.Unlock()
+		if done {
+			break
+		}
+	}
+	access.Lock()
+	defer access.Unlock()
+	if keepalives < 3 || invalid > 0 {
+		t.Fatalf("%d keepalives, %d packets with an invalid IP version", keepalives, invalid)
+	}
+}
+
+// TestAWGKeepaliveRange checks that a keepalive range never picks zero.
+func TestAWGKeepaliveRange(t *testing.T) {
+	private, _ := generateTestKeyPair(t)
+	wgDevice := startAWGDevice(t, "keepalive", private, "", "public_key="+hex.EncodeToString(make([]byte, 31))+"02\nallowed_ip=10.0.0.9/32\npersistent_keepalive_interval=0-30")
+	config, err := wgDevice.IpcGet()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(config, "persistent_keepalive_interval=1-30\n") {
+		t.Fatalf("keepalive not clamped:\n%s", config)
+	}
+	if err := wgDevice.IpcSet("public_key=" + hex.EncodeToString(make([]byte, 31)) + "02\npersistent_keepalive_interval=70000"); err == nil {
+		t.Fatal("keepalive over 65535 accepted")
+	}
+}
+
+type awgTestTUN struct {
+	name     string
+	inbound  chan []byte
+	outbound chan []byte
+	events   chan tun.Event
+	done     chan struct{}
+	reading  chan struct{}
+	once     sync.Once
+}
+
+func (t *awgTestTUN) File() *os.File { return nil }
+
+func (t *awgTestTUN) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	t.once.Do(func() { close(t.reading) })
+	select {
+	case packet := <-t.inbound:
+		sizes[0] = copy(bufs[0][offset:], packet)
+		return 1, nil
+	case <-t.done:
+		return 0, os.ErrClosed
+	}
+}
+
+func (t *awgTestTUN) Write(bufs [][]byte, offset int) (int, error) {
+	for _, buf := range bufs {
+		select {
+		case t.outbound <- bytes.Clone(buf[offset:]):
+		default:
+		}
+	}
+	return len(bufs), nil
+}
+
+func (t *awgTestTUN) MTU() (int, error) { return 1420, nil }
+
+func (t *awgTestTUN) Name() (string, error) { return t.name, nil }
+
+func (t *awgTestTUN) Events() <-chan tun.Event { return t.events }
+
+func (t *awgTestTUN) Close() error {
+	select {
+	case <-t.done:
+	default:
+		close(t.done)
+	}
+	return nil
+}
+
+func (t *awgTestTUN) BatchSize() int { return 1 }
diff --git a/device/awg_uapi.go b/device/awg_uapi.go
new file mode 100644
index 0000000..e4d5478
--- /dev/null
+++ b/device/awg_uapi.go
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ *
+ * AmneziaWG keys of the configuration protocol, as amneziawg-go names them.
+ */
+
+package device
+
+import (
+	"fmt"
+	"strconv"
+
+	"github.com/sagernet/wireguard-go/ipc"
+)
+
+var awgKeys = map[string]bool{
+	"jc": true, "jmin": true, "jmax": true,
+	"s1": true, "s2": true, "s3": true, "s4": true,
+	"h1": true, "h2": true, "h3": true, "h4": true,
+	"i1": true, "i2": true, "i3": true, "i4": true, "i5": true,
+	"j1": true, "j2": true, "j3": true, "itime": true,
+	"header_protection_key": true, "content_padding_addition": true,
+	"rekey_after_time": true, "rekey_timeout": true, "reject_after_time": true,
+	"keepalive_timeout": true, "max_handshake_attempts": true,
+	"random_trailers": true, "disable_cookies": true,
+}
+
+// handleAWGLine applies an AmneziaWG device key of a "set" operation to *next,
+// the pending AmneziaWG settings (created from the current ones on the first
+// key). It reports whether key is an AmneziaWG key.
+func (device *Device) handleAWGLine(next **awgParams, key, value string) (bool, error) {
+	if !awgKeys[key] {
+		return false, nil
+	}
+	if *next == nil {
+		if current := device.awg.Load(); current != nil {
+			*next = current.clone()
+		} else {
+			*next = newAWGParams()
+		}
+	}
+	if err := (*next).set(key, value); err != nil {
+		return true, ipcErrorf(ipc.IpcErrorInvalid, "failed to set %s: %w", key, err)
+	}
+	return true, nil
+}
+
+// commitAWG validates the pending AmneziaWG settings and makes them current.
+func (device *Device) commitAWG(next *awgParams) error {
+	if next == nil {
+		return nil
+	}
+	if err := next.validate(); err != nil {
+		return ipcErrorf(ipc.IpcErrorInvalid, "invalid AmneziaWG settings: %w", err)
+	}
+	device.log.Verbosef("UAPI: Updating AmneziaWG settings")
+	// AmneziaWG datagrams carry data in bytes 1-3, which binds clear for Cloudflare WARP
+	device.net.RLock()
+	bind := device.net.bind
+	device.net.RUnlock()
+	if bind, ok := bind.(interface{ SetPreserveReservedBytes() }); ok {
+		bind.SetPreserveReservedBytes()
+	}
+	device.awg.Store(next)
+	return nil
+}
+
+func (p *awgParams) set(key, value string) error {
+	parse := func(bits int) (uint32, error) {
+		number, err := strconv.ParseUint(value, 10, bits)
+		return uint32(number), err
+	}
+	parseRange := func(r *UintRange) error {
+		return r.FromString(value)
+	}
+	parseChain := func(chain **obfChain) error {
+		parsed, err := newObfChain(value)
+		if err != nil {
+			return err
+		}
+		*chain = parsed
+		return nil
+	}
+	var err error
+	switch key {
+	case "jc":
+		p.junkCount, err = parse(32)
+		if err == nil && p.junkCount > 1000 {
+			err = fmt.Errorf("%d junk packets is too many", p.junkCount)
+		}
+	case "jmin":
+		p.junkMin, err = parse(32)
+	case "jmax":
+		p.junkMax, err = parse(32)
+	case "s1":
+		p.paddings[awgInit], err = parse(16)
+	case "s2":
+		p.paddings[awgResponse], err = parse(16)
+	case "s3":
+		p.paddings[awgCookie], err = parse(16)
+	case "s4":
+		p.paddings[awgTransport], err = parse(16)
+	case "h1":
+		err = parseRange(&p.headers[awgInit])
+	case "h2":
+		err = parseRange(&p.headers[awgResponse])
+	case "h3":
+		err = parseRange(&p.headers[awgCookie])
+	case "h4":
+		err = parseRange(&p.headers[awgTransport])
+	case "i1", "i2", "i3", "i4", "i5":
+		err = parseChain(&p.ipackets[key[1]-'1'])
+	case "j1", "j2", "j3":
+		err = parseChain(&p.jpackets[key[1]-'1'])
+	case "itime":
+		p.itime, err = parse(32)
+	case "header_protection_key":
+		var headerKey HeaderCipherKey
+		err = headerKey.FromHex(value)
+		if err == nil {
+			p.headerKey = nil
+			if !headerKey.IsZero() {
+				p.headerKey = &headerKey
+			}
+		}
+	case "content_padding_addition":
+		err = parseRange(&p.contentPadding)
+	case "rekey_after_time":
+		err = parseRange(&p.rekeyAfterTime)
+	case "rekey_timeout":
+		err = parseRange(&p.rekeyTimeout)
+	case "reject_after_time":
+		err = parseRange(&p.rejectAfterTime)
+	case "keepalive_timeout":
+		err = parseRange(&p.keepaliveTimeout)
+	case "max_handshake_attempts":
+		err = parseRange(&p.maxHandshakeAttempts)
+	case "random_trailers":
+		p.randomTrailers, err = strconv.ParseBool(value)
+	case "disable_cookies":
+		p.disableCookies, err = strconv.ParseBool(value)
+	}
+	return err
+}
+
+// ipcGet writes the AmneziaWG settings for a "get" operation.
+func (p *awgParams) ipcGet(sendf func(format string, args ...any), keyf func(prefix string, key *[32]byte)) {
+	if p == nil {
+		return
+	}
+	if p.junkCount != 0 {
+		sendf("jc=%d", p.junkCount)
+	}
+	if p.junkMin != 0 {
+		sendf("jmin=%d", p.junkMin)
+	}
+	if p.junkMax != 0 {
+		sendf("jmax=%d", p.junkMax)
+	}
+	for kind, padding := range p.paddings {
+		if padding != 0 {
+			sendf("s%d=%d", kind+1, padding)
+		}
+	}
+	for kind, header := range p.headers {
+		sendf("h%d=%s", kind+1, header.String())
+	}
+	for i, chain := range p.ipackets {
+		if chain != nil {
+			sendf("i%d=%s", i+1, chain.Spec)
+		}
+	}
+	for i, chain := range p.jpackets {
+		if chain != nil {
+			sendf("j%d=%s", i+1, chain.Spec)
+		}
+	}
+	if p.itime != 0 {
+		sendf("itime=%d", p.itime)
+	}
+	if p.headerKey != nil {
+		keyf("header_protection_key", (*[32]byte)(p.headerKey))
+	}
+	ranges := []struct {
+		key   string
+		value UintRange
+	}{
+		{"content_padding_addition", p.contentPadding},
+		{"rekey_after_time", p.rekeyAfterTime},
+		{"rekey_timeout", p.rekeyTimeout},
+		{"reject_after_time", p.rejectAfterTime},
+		{"keepalive_timeout", p.keepaliveTimeout},
+		{"max_handshake_attempts", p.maxHandshakeAttempts},
+	}
+	for _, r := range ranges {
+		if !r.value.IsZero() {
+			sendf("%s=%s", r.key, r.value.String())
+		}
+	}
+	if p.randomTrailers {
+		sendf("random_trailers=1")
+	}
+	if p.disableCookies {
+		sendf("disable_cookies=1")
+	}
+}
