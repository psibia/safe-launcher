+
+package device
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+// An obf writes one part of a signature packet. src is the data the chain
+// wraps; signature packets carry no data, so it is empty for them.
+type obf interface {
+	Obfuscate(dst, src []byte)
+	ObfuscatedLen(srcLen int) int
+}
+
+type obfBuilder func(val string) (obf, error)
+
+var obfBuilders = map[string]obfBuilder{
+	"b":  newBytesObf,
+	"t":  newTimestampObf,
+	"r":  newRandObf,
+	"rc": newRandCharObf,
+	"rd": newRandDigitsObf,
+	"d":  newDataObf,
+	"ds": newDataStringObf,
+	"dz": newDataSizeObf,
+	// AmneziaWG 1.5
+	"c":  newCounterObf,
+	"wt": newWaitObf,
+}
+
+// obfChain is a signature packet: a sequence of tags such as
+// "<b 0x0102><r 16><t>". Spec is the text it was parsed from.
+type obfChain struct {
+	Spec string
+	obfs []obf
+}
+
+// newObfChain parses a signature packet; nil if spec has no tags.
+func newObfChain(spec string) (*obfChain, error) {
+	var (
+		obfs []obf
+		errs []error
+	)
+	remaining := spec
+	for {
+		start := strings.IndexByte(remaining, '<')
+		if start == -1 {
+			break
+		}
+		end := strings.IndexByte(remaining[start:], '>')
+		if end == -1 {
+			return nil, errors.New("missing enclosing >")
+		}
+		end += start
+		parts := strings.Fields(remaining[start+1 : end])
+		remaining = remaining[end+1:]
+		if len(parts) == 0 {
+			errs = append(errs, errors.New("empty tag"))
+			continue
+		}
+		key := strings.ToLower(parts[0])
+		builder, ok := obfBuilders[key]
+		if !ok {
+			errs = append(errs, fmt.Errorf("unknown tag <%s>", parts[0]))
+			continue
+		}
+		val := ""
+		if len(parts) > 1 {
+			val = parts[1]
+		}
+		o, err := builder(val)
+		if err != nil {
+			errs = append(errs, fmt.Errorf("failed to build <%s>: %w", parts[0], err))
+			continue
+		}
+		obfs = append(obfs, o)
+	}
+	if len(errs) > 0 {
+		return nil, errors.Join(errs...)
+	}
+	if len(obfs) == 0 {
+		return nil, nil
+	}
+	chain := &obfChain{Spec: spec, obfs: obfs}
+	if size := chain.ObfuscatedLen(0); size > maxPacketSize-MessageEncapsulatingTransportSize {
+		return nil, fmt.Errorf("packet of %d bytes is too large", size)
+	}
+	return chain, nil
+}
+
+func (c *obfChain) Obfuscate(dst, src []byte) {
+	written := 0
+	for _, o := range c.obfs {
+		obfLen := o.ObfuscatedLen(len(src))
+		o.Obfuscate(dst[written:written+obfLen], src)
+		written += obfLen
+	}
+}
+
+func (c *obfChain) ObfuscatedLen(n int) int {
+	total := 0
+	for _, o := range c.obfs {
+		total += o.ObfuscatedLen(n)
+	}
+	return total
+}
+
+// tagLength parses the size of <r>, <rc>, <rd> and <dz>.
+func tagLength(val string) (int, error) {
+	length, err := strconv.Atoi(val)
+	if err != nil {
+		return 0, err
+	}
+	if length < 0 || length > maxPacketSize {
+		return 0, fmt.Errorf("invalid length %d", length)
+	}
+	return length, nil
+}
+
+// <b 0x...>: static bytes.
+type bytesObf struct {
+	data []byte
+}
+
+func newBytesObf(val string) (obf, error) {
+	val = strings.TrimPrefix(strings.TrimPrefix(val, "0x"), "0X")
+	if len(val) == 0 {
+		return nil, errors.New("empty argument")
+	}
+	if len(val)%2 != 0 {
+		// AmneziaWG 1.5 accepted an odd number of digits as if led by a zero.
+		val = "0" + val
+	}
+	data, err := hex.DecodeString(val)
+	if err != nil {
+		return nil, err
+	}
+	return &bytesObf{data: data}, nil
+}
+
+func (o *bytesObf) Obfuscate(dst, src []byte) {
+	copy(dst, o.data)
+}
+
+func (o *bytesObf) ObfuscatedLen(int) int {
+	return len(o.data)
+}
+
+// <t>: current UNIX time, 4 bytes.
+type timestampObf struct{}
+
+func newTimestampObf(string) (obf, error) {
+	return &timestampObf{}, nil
+}
+
+func (o *timestampObf) Obfuscate(dst, src []byte) {
+	binary.BigEndian.PutUint32(dst, uint32(time.Now().Unix()))
+}
+
+func (o *timestampObf) ObfuscatedLen(int) int {
+	return 4
+}
+
+// <r N>: random bytes.
+type randObf struct {
+	length int
+}
+
+func newRandObf(val string) (obf, error) {
+	length, err := tagLength(val)
+	if err != nil {
+		return nil, err
+	}
+	return &randObf{length: length}, nil
+}
+
+func (o *randObf) Obfuscate(dst, src []byte) {
+	_, _ = rand.Read(dst[:o.length])
+}
+
+func (o *randObf) ObfuscatedLen(int) int {
+	return o.length
+}
+
+// <rc N>: random letters.
+const chars52 = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+type randCharObf struct {
+	length int
+}
+
+func newRandCharObf(val string) (obf, error) {
+	length, err := tagLength(val)
+	if err != nil {
+		return nil, err
+	}
+	return &randCharObf{length: length}, nil
+}
+
+func (o *randCharObf) Obfuscate(dst, src []byte) {
+	_, _ = rand.Read(dst[:o.length])
+	for i := range dst[:o.length] {
+		dst[i] = chars52[dst[i]%52]
+	}
+}
+
+func (o *randCharObf) ObfuscatedLen(int) int {
+	return o.length
+}
+
+// <rd N>: random digits.
+const digits10 = "0123456789"
+
+type randDigitObf struct {
+	length int
+}
+
+func newRandDigitsObf(val string) (obf, error) {
+	length, err := tagLength(val)
+	if err != nil {
+		return nil, err
+	}
+	return &randDigitObf{length: length}, nil
+}
+
+func (o *randDigitObf) Obfuscate(dst, src []byte) {
+	_, _ = rand.Read(dst[:o.length])
+	for i := range dst[:o.length] {
+		dst[i] = digits10[dst[i]%10]
+	}
+}
+
+func (o *randDigitObf) ObfuscatedLen(int) int {
+	return o.length
+}
+
+// <d>: the data as is.
+type dataObf struct{}
+
+func newDataObf(string) (obf, error) {
+	return &dataObf{}, nil
+}
+
+func (o *dataObf) Obfuscate(dst, src []byte) {
+	copy(dst, src)
+}
+
+func (o *dataObf) ObfuscatedLen(n int) int {
+	return n
+}
+
+// <ds>: the data in base64.
+type dataStringObf struct{}
+
+func newDataStringObf(string) (obf, error) {
+	return &dataStringObf{}, nil
+}
+
+func (o *dataStringObf) Obfuscate(dst, src []byte) {
+	base64.RawStdEncoding.Encode(dst, src)
+}
+
+func (o *dataStringObf) ObfuscatedLen(n int) int {
+	return base64.RawStdEncoding.EncodedLen(n)
+}
+
+// <dz N>: the data size, N bytes big endian.
+type dataSizeObf struct {
+	length int
+}
+
+func newDataSizeObf(val string) (obf, error) {
+	length, err := tagLength(val)
+	if err != nil {
+		return nil, err
+	}
+	return &dataSizeObf{length: length}, nil
+}
+
+func (o *dataSizeObf) Obfuscate(dst, src []byte) {
+	srcLen := len(src)
+	for i := o.length - 1; i >= 0; i-- {
+		dst[i] = byte(srcLen & 0xFF)
+		srcLen >>= 8
+	}
+}
+
+func (o *dataSizeObf) ObfuscatedLen(int) int {
+	return o.length
+}
+
+// <c>, AmneziaWG 1.5: counter of signature packets sent, 8 bytes big endian.
+var signaturePacketCounter atomic.Uint64
+
+type counterObf struct{}
+
+func newCounterObf(val string) (obf, error) {
+	if val != "" {
+		return nil, errors.New("takes no argument")
+	}
+	return &counterObf{}, nil
+}
+
+func (o *counterObf) Obfuscate(dst, src []byte) {
+	binary.BigEndian.PutUint64(dst, signaturePacketCounter.Add(1))
+}
+
+func (o *counterObf) ObfuscatedLen(int) int {
+	return 8
+}
+
+// <wt N>, AmneziaWG 1.5: a pause of N milliseconds before the next packet.
+// Accepted but not waited for: the pause would hold up the goroutine that
+// sends the handshake, and with it the tunnel's outgoing packets.
+type waitObf struct{}
+
+func newWaitObf(val string) (obf, error) {
+	timeout, err := strconv.Atoi(val)
+	if err != nil {
+		return nil, err
+	}
+	if timeout < 0 || timeout > 5000 {
+		return nil, errors.New("timeout must be from 0 to 5000 ms")
+	}
+	return &waitObf{}, nil
+}
+
+func (o *waitObf) Obfuscate(dst, src []byte) {}
+
+func (o *waitObf) ObfuscatedLen(int) int {
+	return 0
+}
