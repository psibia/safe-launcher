diff --git a/device/keepalive_use_test.go b/device/keepalive_use_test.go
new file mode 100644
index 0000000..b9ad39d
--- /dev/null
+++ b/device/keepalive_use_test.go
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2017-2025 WireGuard LLC. All Rights Reserved.
+ */
+
+package device_test
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// TestKeepaliveWaitsForUse checks that a peer with a persistent keepalive sends nothing until something is sent
+// through it, also when the device goes down and up; that its keepalives go from then on; and that after going down
+// and up a peer in use connects again at once.
+func TestKeepaliveWaitsForUse(t *testing.T) {
+	serverPrivate, serverPublic := generateTestKeyPair(t)
+	clientPrivate, clientPublic := generateTestKeyPair(t)
+	serverPort := freeUDPPort(t)
+	var access sync.Mutex
+	var initiations, keepalives int
+	logf := func(line string) {
+		access.Lock()
+		defer access.Unlock()
+		if strings.Contains(line, "Received handshake initiation") {
+			initiations++
+		}
+		if strings.Contains(line, "Receiving keepalive packet") {
+			keepalives++
+		}
+	}
+	count := func() (int, int) {
+		access.Lock()
+		defer access.Unlock()
+		return initiations, keepalives
+	}
+	waitFor := func(done func(initiations, keepalives int) bool, timeout time.Duration) {
+		for deadline := time.Now().Add(timeout); time.Now().Before(deadline) && !done(count()); {
+			time.Sleep(50 * time.Millisecond)
+		}
+	}
+
+	server := startAWGDeviceWithLog(t, "server", serverPrivate+"\nlisten_port="+fmt.Sprint(serverPort), "",
+		"public_key="+clientPublic+"\nallowed_ip=10.0.0.2/32", logf)
+	client := startAWGDevice(t, "client", clientPrivate, "",
+		"public_key="+serverPublic+"\nendpoint=127.0.0.1:"+fmt.Sprint(serverPort)+"\nallowed_ip=10.0.0.1/32\npersistent_keepalive_interval=1")
+
+	time.Sleep(2500 * time.Millisecond)
+	if err := client.Down(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.Up(); err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(1500 * time.Millisecond)
+	if i, k := count(); i != 0 || k != 0 {
+		t.Fatalf("unused peer: %d handshake initiations, %d keepalives", i, k)
+	}
+
+	request := testIPv4Packet("10.0.0.2", "10.0.0.1", []byte("first"))
+	client.tun.inbound <- request
+	expectPacket(t, server.tun, request)
+	waitFor(func(_, k int) bool { return k >= 3 }, 10*time.Second)
+	used, k := count()
+	if used == 0 || k < 3 {
+		t.Fatalf("peer in use: %d handshake initiations, %d keepalives", used, k)
+	}
+
+	if err := client.Down(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.Up(); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(func(i, _ int) bool { return i > used }, 3*time.Second)
+	if i, _ := count(); i <= used {
+		t.Fatal("peer in use did not connect again after going down and up")
+	}
+}
