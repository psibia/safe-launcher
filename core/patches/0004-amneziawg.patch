diff --git a/transport/wireguard/amnezia.go b/transport/wireguard/amnezia.go
new file mode 100644
index 0000000..bcf5d7c
--- /dev/null
+++ b/transport/wireguard/amnezia.go
@@ -0,0 +1,115 @@
+package wireguard
+
+import (
+	"encoding/base64"
+	"encoding/hex"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+)
+
+// Safe Launcher: AmneziaWG (https://github.com/amnezia-vpn/amneziawg-go) is WireGuard with
+// obfuscated packets. The core's wireguard-go implements it (core/patches/wireguard-go of the
+// launcher); the settings reach it as keys of the device section of the configuration protocol.
+// Received datagrams then keep their bytes 1-3, which carry AmneziaWG data, so a peer of such an
+// endpoint cannot have reserved bytes.
+
+// AmneziaOptions are option.WireGuardAmneziaOptions, field for field.
+type AmneziaOptions struct {
+	JC                     uint32
+	JMin                   uint32
+	JMax                   uint32
+	S1                     uint32
+	S2                     uint32
+	S3                     uint32
+	S4                     uint32
+	H1                     string
+	H2                     string
+	H3                     string
+	H4                     string
+	I1                     string
+	I2                     string
+	I3                     string
+	I4                     string
+	I5                     string
+	J1                     string
+	J2                     string
+	J3                     string
+	ITime                  uint32
+	HeaderProtectionKey    string
+	ContentPaddingAddition string
+	RekeyAfterTime         string
+	RekeyTimeout           string
+	RejectAfterTime        string
+	KeepaliveTimeout       string
+	MaxHandshakeAttempts   string
+	RandomTrailers         bool
+	DisableCookies         bool
+}
+
+// ipcLines returns the set settings as configuration protocol lines, each led by "\n".
+// The device checks the values; an empty result means plain WireGuard.
+func (o *AmneziaOptions) ipcLines() (string, error) {
+	var lines strings.Builder
+	for _, number := range []struct {
+		key   string
+		value uint32
+	}{
+		{"jc", o.JC}, {"jmin", o.JMin}, {"jmax", o.JMax},
+		{"s1", o.S1}, {"s2", o.S2}, {"s3", o.S3}, {"s4", o.S4},
+		{"itime", o.ITime},
+	} {
+		if number.value != 0 {
+			lines.WriteString("\n" + number.key + "=" + F.ToString(number.value))
+		}
+	}
+	for _, text := range []struct {
+		key   string
+		value string
+	}{
+		{"h1", o.H1}, {"h2", o.H2}, {"h3", o.H3}, {"h4", o.H4},
+		{"i1", o.I1}, {"i2", o.I2}, {"i3", o.I3}, {"i4", o.I4}, {"i5", o.I5},
+		{"j1", o.J1}, {"j2", o.J2}, {"j3", o.J3},
+		{"content_padding_addition", o.ContentPaddingAddition},
+		{"rekey_after_time", o.RekeyAfterTime},
+		{"rekey_timeout", o.RekeyTimeout},
+		{"reject_after_time", o.RejectAfterTime},
+		{"keepalive_timeout", o.KeepaliveTimeout},
+		{"max_handshake_attempts", o.MaxHandshakeAttempts},
+	} {
+		value, err := ipcValue("amnezia "+text.key, text.value)
+		if err != nil {
+			return "", err
+		}
+		if value != "" {
+			lines.WriteString("\n" + text.key + "=" + value)
+		}
+	}
+	if o.HeaderProtectionKey != "" {
+		key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(o.HeaderProtectionKey))
+		if err != nil {
+			return "", E.Cause(err, "decode amnezia header_protection_key")
+		}
+		if len(key) != 32 {
+			return "", E.New("invalid amnezia header_protection_key: required 32 bytes, got ", len(key))
+		}
+		lines.WriteString("\nheader_protection_key=" + hex.EncodeToString(key))
+	}
+	if o.RandomTrailers {
+		lines.WriteString("\nrandom_trailers=true")
+	}
+	if o.DisableCookies {
+		lines.WriteString("\ndisable_cookies=true")
+	}
+	return lines.String(), nil
+}
+
+// ipcValue trims value; a line break would start another key of the configuration protocol.
+func ipcValue(name string, value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if strings.ContainsAny(value, "\r\n") {
+		return "", E.New("invalid ", name, ": line break")
+	}
+	return value, nil
+}
