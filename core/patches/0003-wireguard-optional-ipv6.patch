+++ b/transport/wireguard/optional_ipv6.go
@@ -0,0 +1,24 @@
+package wireguard
+
+import (
+	"syscall"
+
+	"github.com/sagernet/sing/common/control"
+)
+
+// Safe Launcher: with auto_detect_interface the WireGuard sockets are bound to the default interface.
+// On Windows binding the IPv6 socket fails ("An invalid argument was supplied") when that interface
+// has no IPv6, and wireguard-go then drops the whole bind, IPv4 included: the endpoint sends nothing.
+// Such an IPv6 listener is reported as unsupported instead, and the bind works over IPv4 alone.
+func optionalIPv6Listener(listenerControl control.Func) control.Func {
+	if listenerControl == nil {
+		return nil
+	}
+	return func(network, address string, conn syscall.RawConn) error {
+		err := listenerControl(network, address, conn)
+		if err != nil && network == "udp6" {
+			return syscall.EAFNOSUPPORT
+		}
+		return err
+	}
+}
