<Window x:Class="KillSwitchLauncher.Views.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Журнал событий"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <!-- Журнал: та же карточка, что у «Что нового», новые события сверху -->
    <Border Margin="36" Width="540" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" Y="14" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuarticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoft}"
                    VerticalAlignment="Center" Margin="0,0,16,0">
                <local:GlyphIcon Glyph="&#xE81C;" Size="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Журнал событий" FontSize="17" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,18,0,0" Background="{StaticResource RowBg}" CornerRadius="16">
                <Grid>
                    <ScrollViewer x:Name="EntriesScroll" Height="380" Focusable="False" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,4,4,4">
                        <ItemsControl x:Name="EntriesList" Margin="14,10,10,4" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{Binding SoftBrush}"
                                                VerticalAlignment="Top">
                                            <local:GlyphIcon Glyph="{Binding Glyph}" Size="11" Foreground="{Binding Brush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="10,0,12,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="17" />
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Пустой журнал -->
                    <TextBlock x:Name="EmptyText" Text="Пока событий нет" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenFileButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Padding="16,9" Content="Открыть файл"
                        ToolTip="Открыть журнал в текстовом редакторе" />
                <Button x:Name="ClearButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="16,9" Margin="10,0,0,0"
                        Content="Очистить" />
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Padding="20,9" MinWidth="104"
                        Content="Закрыть" IsDefault="True" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
