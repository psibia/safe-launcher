<Window x:Class="KillSwitchLauncher.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Загрузка"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <!-- Лоадер загрузки обновления: карточка с полосой прогресса и кнопкой «Отмена» -->
    <Border Margin="36" Width="400" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Круг с вращающейся дугой -->
            <Grid Grid.Row="0" Grid.Column="0" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource AccentSoft}" />
                <local:GlyphIcon Glyph="&#xE896;" Size="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Path x:Name="Spinner" Stroke="{StaticResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 22,2 A 20,20 0 0 1 42,22" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerTurn" />
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Полоса прогресса -->
            <Border x:Name="Track" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="8" CornerRadius="4" Margin="0,22,0,0"
                    Background="{StaticResource RowBg}" ClipToBounds="True">
                <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="4" Background="{StaticResource AccentGradient}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FillShift" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <TextBlock x:Name="ProgressText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                       Foreground="{StaticResource TextMuted}" FontSize="12" Text="Подключение…" />

            <Button x:Name="CancelButton" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,18,0,0"
                    Style="{StaticResource SecondaryButton}" Padding="20,9" MinWidth="104" Content="Отмена" IsCancel="True" />
        </Grid>
    </Border>
</Window>
