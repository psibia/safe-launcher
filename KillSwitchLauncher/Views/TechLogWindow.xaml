<Window x:Class="KillSwitchLauncher.Views.TechLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Технический журнал"
        Icon="pack://application:,,,/Assets/logo.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <!-- Оформление как у окна «Журнал DNS»: карточка со скруглением и тенью, заголовок со значком, кнопка «Закрыть» внизу. -->
    <Window.Resources>
        <!-- Поле поиска: скруглённое, с подсказкой внутри, пока ничего не введено -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource RowBg}" CornerRadius="20" Padding="14,0,14,0" MinHeight="40"
                                BorderThickness="1.5" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка: подсветка при наведении, выделенные строки — заметный акцентный фон (видно и без фокуса) -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9E9EF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCDCFB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Прокрутка строк: заметнее общей тонкой полосы (строк много), с дорожкой и ползунком, который можно тянуть -->
        <Style x:Key="LogScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="5" Background="#B4B4C0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E8E9C" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Margin" Value="4,6,4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{StaticResource SubtleBg}" CornerRadius="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LogScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Margin" Value="6,4,6,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{StaticResource SubtleBg}" CornerRadius="5">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource LogScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Строка журнала: моноширинный шрифт, без переноса. Отметка пользователя — на всю ширину. -->
        <DataTemplate x:Key="LineTemplate">
            <Grid>
                <Grid x:Name="Regular">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="Bold" />
                    <TextBlock Grid.Column="3" Text="{Binding Area}" Foreground="{StaticResource TextSecondary}" ToolTip="{Binding Code}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <!-- У строк ядра: длительность соединения, по правому краю, чтобы текст после нее начинался ровно -->
                    <TextBlock Grid.Column="4" Text="{Binding Duration}" Foreground="{StaticResource TextMuted}" TextAlignment="Right" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="5" Text="{Binding Text}" Foreground="{Binding TextBrush}" />
                </Grid>
                <Border x:Name="Marker" Visibility="Collapsed" Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="8,2" Margin="0,2">
                    <TextBlock Foreground="{StaticResource Accent}" FontWeight="SemiBold">
                        <Run Text="{Binding Time, Mode=OneWay}" />
                        <Run Text="  ──── " />
                        <Run Text="{Binding Text, Mode=OneWay}" />
                        <Run Text=" ────" />
                    </TextBlock>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMarker}" Value="True">
                    <Setter TargetName="Regular" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Card" Margin="36" Width="1000" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" Y="14" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuarticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок: значок, название, число строк и состояние журналов службы; развернуть на весь экран (и двойной щелчок), закрыть -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoft}"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <local:GlyphIcon Glyph="&#xE9D9;" Size="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Технический журнал" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock x:Name="UnavailableHeader" Foreground="{StaticResource Warn}" FontSize="12" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ExpandButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,0,6,0"
                        ToolTip="Развернуть на весь экран (F11)">
                    <TextBlock x:Name="ExpandGlyph" Text="&#xE740;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button x:Name="CloseCornerButton" Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
            </Grid>

            <!-- Источник, период, типы событий. Ширина кнопок постоянная: выбор не двигает соседние элементы. -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                    <UniformGrid Columns="4" Width="360">
                        <RadioButton x:Name="TabAll" Style="{StaticResource SegmentRadio}" Content="Все" GroupName="Tab" IsChecked="True" />
                        <RadioButton x:Name="TabLauncher" Style="{StaticResource SegmentRadio}" Content="Лаунчер" GroupName="Tab" />
                        <RadioButton x:Name="TabService" Style="{StaticResource SegmentRadio}" Content="Служба" GroupName="Tab" />
                        <RadioButton x:Name="TabCore" Style="{StaticResource SegmentRadio}" Content="Ядро" GroupName="Tab" />
                    </UniformGrid>
                </Border>
                <Button x:Name="PeriodButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Width="250" Padding="16,9" Margin="12,0,0,0"
                        HorizontalContentAlignment="Stretch">
                    <!-- Ширина содержимого = ширина кнопки минус отступы: стрелка всегда у правого края, длинный текст обрезается -->
                    <Grid Width="218">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PeriodText" Grid.Column="0" Text="Период: последний час" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button x:Name="TypesButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Width="250" Padding="16,9" Margin="10,0,0,0"
                        HorizontalContentAlignment="Stretch">
                    <Grid Width="218">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TypesText" Grid.Column="0" Text="Типы: все" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Поиск и «только ошибки» -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                         Tag="Поиск по словам; code:core.start — точный код события" />
                <CheckBox x:Name="ErrorsOnlyBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Только ошибки" FontWeight="SemiBold" />
                </CheckBox>
            </Grid>

            <!-- Строки: высота подстраивается под экран (ShowFor) -->
            <Border x:Name="ListHost" Grid.Row="3" Margin="0,16,0,0" Height="400" Background="{StaticResource RowBg}" CornerRadius="16">
                <Grid>
                    <ListBox x:Name="LinesList" Background="Transparent" BorderThickness="0" Margin="8,8,2,2"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12"
                             TextOptions.TextFormattingMode="Display"
                             ItemTemplate="{StaticResource LineTemplate}" ItemContainerStyle="{StaticResource RowItem}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Visible"
                             SelectionMode="Extended">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource LogScrollBar}" />
                        </ListBox.Resources>
                    </ListBox>
                    <TextBlock x:Name="CenterText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="460" Foreground="{StaticResource TextMuted}" Visibility="Collapsed" IsHitTestVisible="False" />
                    <Button x:Name="NewLinesButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,16" Padding="16,7" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Отметка, экспорт, закрыть -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="MarkButton" Style="{StaticResource SecondaryButton}" Padding="18,9" Content="Отметить проблему"
                            ToolTip="Поставить отметку времени во все журналы" />
                    <StackPanel x:Name="MarkPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="MarkText" Style="{StaticResource InputBox}" Width="260" MaxLength="200" Tag="Что случилось (необязательно)" />
                        <Button x:Name="MarkConfirm" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="10,0,0,0" Content="Отметить" />
                        <Button x:Name="MarkCancel" Style="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Отмена">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ExportButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Padding="18,9" Content="Экспорт"
                        ToolTip="Сохранить то, что показано, в файл .log" />
                <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource PrimaryButton}" Padding="20,9" MinWidth="104" Margin="10,0,0,0"
                        Content="Закрыть" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
