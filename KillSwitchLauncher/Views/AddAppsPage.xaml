<UserControl x:Class="KillSwitchLauncher.Views.AddAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KillSwitchLauncher.Views">
    <!-- «Добавить приложения» (DataContext — AddAppsViewModel): программы из меню «Пуск» с галочками, как в мастере
         первого запуска, и «Выбрать в проводнике» для одной программы, которой нет в списке. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Заголовок страницы ===================== -->
        <Grid Grid.Row="0" Margin="40,0,40,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="16,9" ToolTip="Вернуться к приложениям (Esc)"
                    Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <views:GlyphIcon Glyph="&#xE72B;" Size="12" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="Приложения" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Добавить приложения" Style="{StaticResource PageTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Margin="20,0,20,0" CornerRadius="28" Background="{StaticResource PanelBg}">
            <Grid Margin="30,20,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"
                           Text="Отметьте программы из меню «Пуск». Уже добавленные отмечены серым: убрать их можно в меню плитки." />

                <Border Grid.Row="1" Style="{StaticResource PageCard}" Padding="8">
                    <views:StartMenuList DataContext="{Binding List}" />
                </Border>

                <!-- ===== Программы нет в списке ===== -->
                <Border Grid.Row="2" Style="{StaticResource SettingRow}" Background="{StaticResource CardBg}" Effect="{StaticResource SmallShadow}"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                            <views:GlyphIcon Glyph="&#xE838;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Нужной программы нет в списке" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap"
                                       Text="Выберите её .exe или ярлык. Можно и перетащить их в окно." />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="16,8" VerticalAlignment="Center"
                                Content="Выбрать в проводнике" Command="{Binding BrowseCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Добавить / Отмена ===================== -->
        <Border Grid.Row="2" Margin="20,12,20,14" Background="{StaticResource CardBg}" CornerRadius="22" Padding="20,10,10,10"
                Effect="{StaticResource SmallShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SelectedText}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,8,0" Content="Отмена"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="18,8" Content="{Binding AddText}"
                        Command="{Binding AddCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
