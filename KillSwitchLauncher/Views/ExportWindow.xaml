<Window x:Class="KillSwitchLauncher.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Выгрузить журналы для анализа"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Вариант периода: кружок с точкой -->
        <Style x:Key="PeriodRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="#D6D6DE" Fill="{StaticResource CardBg}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Accent}" Opacity="0" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="36" Width="520" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoft}" Margin="0,0,16,0">
                    <local:GlyphIcon Glyph="&#xE896;" Size="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Выгрузить журналы для анализа" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="Все журналы за выбранное время в одном архиве" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="За какое время" FontWeight="Bold" Margin="0,20,0,10" />
            <StackPanel x:Name="PeriodsPanel" />
            <RadioButton x:Name="CustomRadio" Style="{StaticResource PeriodRadio}" Content="Свой промежуток" GroupName="Period" />
            <Grid x:Name="CustomPanel" Margin="28,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Дата и время выбираются из списка (день, час, минуты через 5): ошибиться в записи нельзя -->
                <TextBlock Grid.Column="0" Text="с" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                <local:DateTimeField x:Name="FromField" Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="по" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource TextSecondary}" />
                <local:DateTimeField x:Name="ToField" Grid.Column="3" AllowNow="True" />
            </Grid>

            <TextBlock Text="Что случилось (необязательно)" FontWeight="Bold" Margin="0,14,0,8" />
            <TextBox x:Name="NoteBox" Style="{StaticResource InputBox}" MaxLength="500" Tag="Например: WG перестал работать после запуска второго приложения" />

            <StackPanel Margin="0,16,0,0">
                <CheckBox x:Name="HideAddressesBox" Style="{StaticResource SoftCheckBox}" Content="Скрыть IP-адреса" />
                <TextBlock x:Name="HideAddressesNote" Text="Адреса в журналах уже скрыты" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                           Margin="27,2,0,0" Visibility="Collapsed" />
                <CheckBox x:Name="HideSitesBox" Style="{StaticResource SoftCheckBox}" Content="Скрыть имена сайтов" Margin="0,10,0,0" />
                <CheckBox x:Name="DnsBox" Style="{StaticResource SoftCheckBox}" Content="Добавить журналы DNS приложений" Margin="0,10,0,0" />
                <CheckBox x:Name="CoreErrorsBox" Style="{StaticResource SoftCheckBox}" Margin="0,10,0,0" Visibility="Collapsed"
                          Content="Подключения: только ошибки, кроме 15 минут вокруг отметок" />
            </StackPanel>

            <!-- Оценка размера, предупреждения (служба недоступна, записей нет, много записей) -->
            <TextBlock x:Name="EstimateText" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,16,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningText" Foreground="{StaticResource Warn}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="18,9" Content="Отмена" IsCancel="True" />
                <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="20,9" MinWidth="130" Margin="10,0,0,0"
                        Content="Сохранить" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
