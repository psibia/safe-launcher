<Window x:Class="KillSwitchLauncher.Views.DnsJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Журнал DNS"
        Icon="pack://application:,,,/Assets/logo.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Строка списка: мягкая подсветка при наведении и выделении вместо системной синей -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,5" Margin="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Запрос (режим «все запросы») или отметка «Новый запуск» -->
        <DataTemplate DataType="{x:Type local:DnsQueryRow}">
            <Grid>
                <Grid Visibility="{Binding IsQuery, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                    <TextBlock Grid.Column="1" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2" Text="{Binding TypeText}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="{Binding ProcessText}" Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessText}" />
                </Grid>
                <Grid Visibility="{Binding IsMarker, Converter={StaticResource BoolToVis}}" Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" Background="{StaticResource Divider}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding MarkerText}" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                               FontWeight="SemiBold" Margin="12,0" />
                    <Border Grid.Column="2" Height="1" Background="{StaticResource Divider}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Домен (режим «только уникальные») -->
        <DataTemplate DataType="{x:Type local:DnsDomainRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding TypesText}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="{Binding LastSeenText}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="36" Width="820" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" Y="14" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuarticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок: значок, название приложения, состояние записи -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoft}"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <local:GlyphIcon Glyph="&#xE774;" Size="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Журнал DNS" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock x:Name="StateText" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                        <TextBlock x:Name="CountsText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="CloseCornerButton" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
            </Grid>

            <!-- Поиск, режим и копирование -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}" Tag="Поиск по домену" />
                <CheckBox x:Name="UniqueToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0" VerticalAlignment="Center"
                          ToolTip="Каждый домен одной строкой, со счётчиком запросов">
                    <TextBlock Text="Только уникальные" FontWeight="SemiBold" />
                </CheckBox>
                <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="18,9" Margin="18,0,0,0"
                        ToolTip="Скопировать домены выделенных строк (Ctrl+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="CopyText" Text="Копировать" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Список -->
            <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource RowBg}" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Заголовки колонок: отступы совпадают со строками (10 у строки + 14 у списка) -->
                    <Grid x:Name="QueriesHeader" Grid.Row="0" Margin="24,12,24,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Время" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Домен" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Тип" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Процесс · PID" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                    </Grid>
                    <Grid x:Name="DomainsHeader" Grid.Row="0" Margin="24,12,24,6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Домен" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Типы" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Запросов" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Последний" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold" />
                    </Grid>

                    <ListBox x:Name="RowsList" Grid.Row="1" Height="400" Margin="14,0,4,8" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" />

                    <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Пока запросов нет" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="520" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <!-- Подсказка и кнопка закрытия -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"
                           Margin="0,0,20,0"
                           Text="Видны запросы через DNS Windows. Браузеры с включённым «безопасным DNS» (DNS over HTTPS) и обращения напрямую по IP сюда не попадают." />
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="20,9" MinWidth="104"
                        Content="Закрыть" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
