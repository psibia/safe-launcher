<Window x:Class="KillSwitchLauncher.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillSwitchLauncher.Views"
        Title="Безопасный лаунчер"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True">

    <!-- Диалог в стиле лаунчера: белая карточка, круг с иконкой, кнопки-«таблетки» справа внизу.
         Внешний Margin — место под тень. -->
    <Border x:Name="Card" Margin="36" Width="420" CornerRadius="24" Background="{StaticResource CardBg}" Padding="26,24,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.16" Color="#1A1A2E" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" Y="14" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="CardShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                            <DoubleAnimation.EasingFunction>
                                <QuarticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBox" Grid.Row="0" Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    VerticalAlignment="Top" Margin="0,0,16,0">
                <local:GlyphIcon x:Name="IconGlyph" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"
                           TextWrapping="Wrap" LineHeight="19" />
            </StackPanel>

            <!-- Необязательная галочка под текстом (например, «Больше не спрашивать») -->
            <CheckBox x:Name="OptionCheck" Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" Style="{StaticResource SoftCheckBox}"
                      Visibility="Collapsed" />

            <!-- Необязательное поле ввода под текстом (ключ лицензии) и строка ошибки под ним -->
            <StackPanel x:Name="InputHost" Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" Visibility="Collapsed">
                <TextBox x:Name="InputText" Style="{StaticResource InputBox}" />
                <TextBlock x:Name="InputError" Foreground="{StaticResource Danger}" Margin="2,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="ButtonsHost" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0" />
        </Grid>
    </Border>
</Window>
