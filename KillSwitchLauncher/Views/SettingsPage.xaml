<UserControl x:Class="KillSwitchLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KillSwitchLauncher.Views">
    <!-- Страница настроек (DataContext — MainViewModel): разделы слева, содержимое справа.
         Изменения вступают в силу по «Применить» в нижней полосе, которая появляется только при изменениях. -->
    <UserControl.Resources>
        <!-- Подключение в разделе «Подключения лаунчера»: проверка, переименование, обновление подписки, удаление -->
        <DataTemplate x:Key="ConnectionRowTemplate">
            <Border Style="{StaticResource SettingRow}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource CardBg}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <!-- Название или поле для нового названия -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Основное" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}" MinHeight="34" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisibleChanged="OnRenameBoxVisibleChanged">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveNameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding SaveNameCommand}" ToolTip="Сохранить">
                                    <views:GlyphIcon Glyph="&#xE73E;" Size="12" />
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding CancelRenameCommand}" ToolTip="Отмена">
                                    <views:GlyphIcon Glyph="&#xE711;" Size="11" />
                                </Button>
                            </Grid>

                            <TextBlock FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding KindText, Mode=OneWay}" />
                                <Run Text=" · " Foreground="{StaticResource TextMuted}" />
                                <Run Text="{Binding Details, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding UsedBy}" FontSize="11.5" Margin="0,1,0,0" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CheckText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CheckText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Проверить"
                                    Command="{Binding CheckCommand}" ToolTip="Подключиться и узнать задержку, страну и IP" />
                            <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Margin="6,0,0,0" Content="Обновить"
                                    Command="{Binding UpdateCommand}" ToolTip="Загрузить список серверов заново"
                                    Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding StartRenameCommand}" ToolTip="Переименовать">
                                <views:GlyphIcon Glyph="&#xE70F;" Size="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding DeleteCommand}" ToolTip="Удалить подключение">
                                <views:GlyphIcon Glyph="&#xE74D;" Size="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Серверы подписки: выбор, через какой из них идти -->
                    <StackPanel Margin="40,8,0,0" Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsServersExpanded}">
                            <TextBlock Text="{Binding ServersToggleText}" TextTrimming="CharacterEllipsis" />
                        </ToggleButton>
                        <ScrollViewer MaxHeight="240" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" Visibility="{Binding IsServersExpanded, Converter={StaticResource BoolToVis}}">
                        <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ChoiceItem}" Margin="0,0,8,0"
                                 ItemsSource="{Binding Servers}" SelectedValuePath="Key" SelectedValue="{Binding SelectedServerKey}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Заголовок страницы ===================== -->
        <Grid Grid.Row="0" Margin="40,0,40,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="16,9" Command="{Binding BackCommand}" ToolTip="Вернуться к приложениям (Esc)">
                <StackPanel Orientation="Horizontal">
                    <views:GlyphIcon Glyph="&#xE72B;" Size="12" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="Приложения" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Настройки" Style="{StaticResource PageTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- ===================== Разделы и содержимое ===================== -->
        <Border Grid.Row="1" Margin="20,0,20,0" CornerRadius="28" Background="{StaticResource PanelBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="18,22,8,20">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE968;" Content="Подключение"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Connection}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="Подключения лаунчера"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Connections}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE839;" Content="Адаптеры"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Adapters}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Защита"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Protection}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8A7;" Content="Окно и трей"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Window}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Журнал событий"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Log}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE946;"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="О программе" VerticalAlignment="Center" />
                            <!-- Найдено обновление -->
                            <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentGradient}" Margin="8,0,0,0"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <ScrollViewer Grid.Column="1" Margin="0,10,6,10" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="10,12,28,24" MaxWidth="760" HorizontalAlignment="Left">

                        <!-- ===== Подключение: общее условие запуска ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Connection}">
                            <TextBlock Text="Как запускать приложения" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Общее условие для всех приложений. У отдельного приложения можно выбрать своё в его настройках." />

                            <StackPanel>
                                <RadioButton Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding NetworkMode, Converter={StaticResource EnumToBool}, ConverterParameter=SystemVpn}">
                                    <StackPanel>
                                        <TextBlock Text="Системный VPN" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="Ваша VPN-программа включена на весь компьютер. Маршрутом управляет она, лаунчер следит, что VPN включён, и не запускает приложения без него." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding NetworkMode, Converter={StaticResource EnumToBool}, ConverterParameter=LauncherConnection}">
                                    <StackPanel>
                                        <TextBlock Text="Подключение лаунчера" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="Лаунчер сам подключается к серверу и ведёт через него только ваши приложения. Остальные программы работают как обычно." />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Выбор подключения -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsLauncherMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ЧЕРЕЗ КАКОЕ ПОДКЛЮЧЕНИЕ" Style="{StaticResource GroupTitle}" Margin="4,0,0,8" />
                                <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                         ItemTemplate="{StaticResource ConnectionChoiceTemplate}"
                                         ItemsSource="{Binding Connections}" SelectedValuePath="Id" SelectedValue="{Binding DraftConnectionId}"
                                         Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}" />

                                <Border Style="{StaticResource SettingRow}" Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Text="Подключений пока нет. Добавьте ссылку или подписку от вашего VPN-сервиса." />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="14,6" FontSize="12" Margin="10,0,0,0"
                                                Content="Добавить подключение" Command="{Binding ShowSectionCommand}" CommandParameter="Connections" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource WarnBox}" Margin="0,8,0,0">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                            <Binding Path="NeedsConnectionSelection" />
                                            <Binding Path="HasConnections" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                               Text="Выберите подключение, через которое пойдут приложения." />
                                </Border>

                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,10,0,0"
                                        Command="{Binding ShowSectionCommand}" CommandParameter="Connections"
                                        Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Добавить или проверить подключения →" />
                                </Button>
                            </StackPanel>

                            <!-- Системный VPN: какие адаптеры -->
                            <Border Style="{StaticResource SettingRow}" Margin="0,14,0,0" Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Какой VPN считается включённым" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding RuleDescription}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Margin="10,0,0,0"
                                            Content="Адаптеры" Command="{Binding ShowSectionCommand}" CommandParameter="Adapters" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== Подключения лаунчера ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Connections}">
                            <TextBlock Text="Подключения лаунчера" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Серверы, через которые лаунчер может вести приложения. Какое использовать, выбирается в разделе «Подключение» или в настройках приложения." />
                            <ItemsControl ItemsSource="{Binding Connections}" ItemTemplate="{StaticResource ConnectionRowTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,4" Text="Пока нет ни одного подключения."
                                       Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="Добавить подключение" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" />
                            <Border Style="{StaticResource PageCard}" Padding="18,16">
                                <views:AddConnectionForm DataContext="{Binding AddConnection}" />
                            </Border>
                        </StackPanel>

                        <!-- ===== Адаптеры ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Adapters}">
                            <TextBlock Text="Когда VPN считается подключённым" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Для «Системного VPN»: маршрутом управляет ваша VPN-программа, а лаунчер следит, что она включена. С «Блокировать трафик мимо VPN» приложения выходят в интернет только через эти адаптеры." />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Любой VPN"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyVpn}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Один из"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyOfSelected}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Все"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AllOfSelected}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="4,8,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Подойдёт любой активный VPN. Переключатели адаптеров ниже не используются." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RuleMode}" Value="AnyOfSelected">
                                                <Setter Property="Text" Value="Достаточно, чтобы был активен хотя бы один из включённых адаптеров." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RuleMode}" Value="AllOfSelected">
                                                <Setter Property="Text" Value="Должны быть активны все включённые адаптеры одновременно." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource WarnBox}" Margin="0,0,0,16"
                                    Visibility="{Binding NeedsAdapterSelection, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:GlyphIcon Grid.Column="0" Glyph="&#xE7BA;" Size="14" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                               Text="Не включён ни один адаптер, поэтому VPN считается отключённым. Включите нужный VPN ниже." />
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Сетевые адаптеры" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RefreshAdaptersCommand}" ToolTip="Обновить список адаптеров">
                                    <views:GlyphIcon Glyph="&#xE72C;" Size="12" />
                                </Button>
                            </Grid>

                            <!-- Фильтр списка: применяется сразу и не сохраняется -->
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAllAdapters}">
                                    <StackPanel>
                                        <TextBlock Text="Показывать все адаптеры" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="Если ваш VPN не распознался автоматически" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,8,0,0" ItemTemplate="{StaticResource AdapterRowTemplate}" />

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowOtherGroup, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ДРУГИЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" />
                                <TextBlock Text="Не похожи на VPN. Включите нужный, если ваш VPN не распознался." Style="{StaticResource Caption}" Margin="4,2,0,10" />
                                <ItemsControl ItemsSource="{Binding OtherAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRemovedAdapters, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="УДАЛЁННЫЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ExpanderToggle}" HorizontalAlignment="Right" IsChecked="{Binding IsRemovedExpanded}">
                                        <TextBlock Text="{Binding RemovedToggleText}" Margin="0,0,8,0" />
                                    </ToggleButton>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,10"
                                           Text="Лаунчер уже видел их, но сейчас их нет в системе. Некоторые VPN создают адаптер только на время подключения." />
                                <ItemsControl ItemsSource="{Binding RemovedAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}"
                                              Visibility="{Binding IsRemovedExpanded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== Защита ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Protection}">
                            <TextBlock Text="Защита" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Общие значения. У отдельного приложения можно задать своё в его настройках." />

                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RequireVpn}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE72E;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Не запускать без VPN" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="Приложение не запустится, пока VPN не подключён. С подключением лаунчера — пока сервер не ответит." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KillSwitchEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE7E8;" Size="14" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Закрывать при обрыве (Kill-Switch)" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="Если VPN отключился или сервер перестал отвечать, приложения закроются. С подключением лаунчера трафик и так не уйдёт мимо сервера." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                            <TextBlock Text="Выключение Kill-Switch потребует подтверждения." Style="{StaticResource Caption}" Margin="4,8,0,0" />

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BlockBypass}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE8F8;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Блокировать трафик мимо VPN" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="Фильтр Windows пускает программы приложения в интернет только через его VPN. Даже если программа сама попробует выйти напрямую (так делают браузеры и мессенджеры для звонков), соединение не состоится." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Margin="4,8,0,0"
                                       Text="Действует, пока приложение запущено, и только на его программы. Для них закрыты домашняя сеть (принтеры, NAS) и системный прокси другой VPN-программы. Если та же программа открыта и не через лаунчер, ограничение действует и на неё. Программы Windows и служб не ограничиваются: это затронуло бы весь компьютер. Для приложений под системным VPN — только с «Не запускать без VPN»." />

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideDns}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource WarnSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE774;" Size="14" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Скрывать DNS-запросы от провайдера" FontWeight="Bold" FontSize="14" />
                                                <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Весь компьютер" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="Без этой настройки трафик приложений идёт через VPN, но имена сайтов, которые они открывают, может видеть провайдер. Влияет на DNS всех программ компьютера, пока работает приложение лаунчера." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,8,0,0" Command="{Binding ShowHideDnsInfoCommand}">
                                <TextBlock Text="Как это работает и на что влияет →" />
                            </Button>
                        </StackPanel>

                        <!-- ===== Окно и трей ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Window}">
                            <TextBlock Text="Действие при закрытии" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,14" />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Спрашивать"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Ask}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="В трей"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Tray}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Закрыть"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Exit}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="4,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Каждый раз спрашивать, свернуть в трей или закрыть. Относится к кнопке «Закрыть» вверху окна, Alt+F4 и закрытию с панели задач." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideBehavior}" Value="Tray">
                                                <Setter Property="Text" Value="Лаунчер уходит в трей и продолжает следить за приложениями. Закрыть его можно из меню значка в трее." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HideBehavior}" Value="Exit">
                                                <Setter Property="Text" Value="Лаунчер закрывается. Запущенные приложения, которые без него остались бы без защиты, закроются тоже: лаунчер спросит." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="4,14,0,0"
                                       Text="Значок в трее показывает состояние: красный — есть приложения без защиты. В его меню можно завершить запущенные приложения." />

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE7E8;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Запускать вместе с Windows" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="После входа в Windows лаунчер сразу работает в трее. Приложения он сам не запускает." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <!-- ===== Журнал событий ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Log}">
                            <TextBlock Text="Журнал событий" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,14" />
                            <Border Style="{StaticResource SettingRow}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE81C;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="Журнал событий" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="VPN и подключения, запуски и закрытия приложений" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12"
                                            VerticalAlignment="Center" Content="Открыть" Command="{Binding ShowLogCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== О программе ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=About}">
                            <TextBlock Text="О программе" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,14" />
                            <Border Padding="14,10" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SettingRow}">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE895;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppVersionText}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UpdateStatusText}" Margin="0,1,0,0" ToolTip="{Binding UpdateStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12"
                                            Margin="0,0,6,0" VerticalAlignment="Center" Content="Что нового"
                                            Command="{Binding ShowChangelogCommand}" IsEnabled="{Binding CanUseUpdates}"
                                            ToolTip="Описание изменений: установленной версии или доступного обновления" />
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Проверить"
                                                Command="{Binding UpdateActionCommand}" IsEnabled="{Binding CanUseUpdates}"
                                                Visibility="{Binding IsUpdateNotAvailable, Converter={StaticResource BoolToVis}}" ToolTip="Проверить обновления" />
                                        <Button Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Обновить"
                                                Command="{Binding UpdateActionCommand}" IsEnabled="{Binding CanUseUpdates}"
                                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" ToolTip="Скачать и установить обновление" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== Применить / Отменить: только когда есть изменения ===================== -->
        <Border Grid.Row="2" Margin="20,12,20,14" Background="{StaticResource CardBg}" CornerRadius="22" Padding="20,10,10,10"
                Effect="{StaticResource SmallShadow}" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Изменения вступят в силу после «Применить»" Foreground="{StaticResource Warn}"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,8,0" Content="Отменить"
                        Command="{Binding CancelSettingsCommand}" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="18,8" Content="Применить"
                        Command="{Binding ApplySettingsCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
