<UserControl x:Class="KillSwitchLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KillSwitchLauncher.Views">
    <!-- Страница настроек (DataContext — MainViewModel): разделы слева, содержимое справа.
         Изменения вступают в силу по «Применить» в нижней полосе, которая появляется только при изменениях. -->
    <UserControl.Resources>
        <!-- Подключение в разделе «Подключения лаунчера»: проверка, переименование, обновление подписки, удаление -->
        <DataTemplate x:Key="ConnectionRowTemplate">
            <Border Style="{StaticResource SettingRow}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource CardBg}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <!-- Название или поле для нового названия -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Основное" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Grid Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource InputBox}" MinHeight="34" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisibleChanged="OnRenameBoxVisibleChanged">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveNameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding SaveNameCommand}" ToolTip="Сохранить">
                                    <views:GlyphIcon Glyph="&#xE73E;" Size="12" />
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding CancelRenameCommand}" ToolTip="Отмена">
                                    <views:GlyphIcon Glyph="&#xE711;" Size="11" />
                                </Button>
                            </Grid>

                            <TextBlock FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding KindText, Mode=OneWay}" />
                                <Run Text=" · " Foreground="{StaticResource TextMuted}" />
                                <Run Text="{Binding Details, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding UsedBy}" FontSize="11.5" Margin="0,1,0,0" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CheckText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CheckText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Проверить"
                                    Command="{Binding CheckCommand}" ToolTip="Подключиться и узнать задержку, страну и IP" />
                            <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Margin="6,0,0,0" Content="Обновить"
                                    Command="{Binding UpdateCommand}" ToolTip="Загрузить список серверов заново"
                                    Visibility="{Binding IsSubscription, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding StartRenameCommand}" ToolTip="Переименовать">
                                <views:GlyphIcon Glyph="&#xE70F;" Size="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding DeleteCommand}" ToolTip="Удалить подключение">
                                <views:GlyphIcon Glyph="&#xE74D;" Size="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Серверы подписки: выбор, через какой из них идти -->
                    <StackPanel Margin="40,8,0,0" Visibility="{Binding HasServers, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsServersExpanded}">
                            <TextBlock Text="{Binding ServersToggleText}" TextTrimming="CharacterEllipsis" />
                        </ToggleButton>
                        <ScrollViewer MaxHeight="240" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False" Visibility="{Binding IsServersExpanded, Converter={StaticResource BoolToVis}}">
                        <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ChoiceItem}" Margin="0,0,8,0"
                                 ItemsSource="{Binding Servers}" SelectedValuePath="Key" SelectedValue="{Binding SelectedServerKey}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Заголовок страницы ===================== -->
        <Grid Grid.Row="0" Margin="40,0,40,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="16,9" Command="{Binding BackCommand}" ToolTip="Вернуться к приложениям (Esc)">
                <StackPanel Orientation="Horizontal">
                    <views:GlyphIcon Glyph="&#xE72B;" Size="12" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Text="Приложения" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Настройки" Style="{StaticResource PageTitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- ===================== Разделы и содержимое ===================== -->
        <Border Grid.Row="1" Margin="20,0,20,0" CornerRadius="28" Background="{StaticResource PanelBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Список разделов; под ним, внизу колонки, версия лаунчера -->
                <DockPanel Grid.Column="0" Margin="18,22,8,20">
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersionText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="14,0,0,0" />
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE968;" Content="Подключение"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Connection}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="Подключения лаунчера"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Connections}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE839;" Content="Адаптеры"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Adapters}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Защита"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Protection}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71C;" Content="Исключения"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Exclusions}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8A7;" Content="Окно и трей"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Window}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Журналы"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Log}" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE895;"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumToBool}, ConverterParameter=Updates}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Обновления" VerticalAlignment="Center" />
                                <!-- Найдена новая версия -->
                                <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentGradient}" Margin="8,0,0,0"
                                        Visibility="{Binding IsUpdateFound, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Column="1" Margin="0,10,6,10" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Ширина содержимого постоянная (до 760): не зависит от длины текстов в разделе, поэтому ничего не прыгает -->
                    <Grid Margin="10,12,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="760" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== Подключение: общее условие запуска ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Connection}">
                            <TextBlock Text="Как запускать приложения" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Общее условие для всех приложений. У отдельного приложения можно выбрать своё в его настройках." />

                            <StackPanel>
                                <RadioButton Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding NetworkMode, Converter={StaticResource EnumToBool}, ConverterParameter=SystemVpn}">
                                    <StackPanel>
                                        <TextBlock Text="Системный VPN" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="Ваша VPN-программа включена на весь компьютер. Маршрутом управляет она, лаунчер следит, что VPN включён, и не запускает приложения без него." />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCard}"
                                             IsChecked="{Binding NetworkMode, Converter={StaticResource EnumToBool}, ConverterParameter=LauncherConnection}">
                                    <StackPanel>
                                        <TextBlock Text="Подключение лаунчера" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   Text="Лаунчер сам подключается к серверу и ведёт через него только ваши приложения. Остальные программы работают как обычно." />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Выбор подключения -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsLauncherMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ЧЕРЕЗ КАКОЕ ПОДКЛЮЧЕНИЕ" Style="{StaticResource GroupTitle}" Margin="4,0,0,8" />
                                <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                         ItemTemplate="{StaticResource ConnectionChoiceTemplate}"
                                         ItemsSource="{Binding Connections}" SelectedValuePath="Id" SelectedValue="{Binding DraftConnectionId}"
                                         Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}" />

                                <Border Style="{StaticResource SettingRow}" Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Text="Подключений пока нет. Добавьте ссылку или подписку от вашего VPN-сервиса." />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="14,6" FontSize="12" Margin="10,0,0,0"
                                                Content="Добавить подключение" Command="{Binding ShowSectionCommand}" CommandParameter="Connections" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource WarnBox}" Margin="0,8,0,0">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                            <Binding Path="NeedsConnectionSelection" />
                                            <Binding Path="HasConnections" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                               Text="Выберите подключение, через которое пойдут приложения." />
                                </Border>

                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,10,0,0"
                                        Command="{Binding ShowSectionCommand}" CommandParameter="Connections"
                                        Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Добавить или проверить подключения →" />
                                </Button>
                            </StackPanel>

                            <!-- Системный VPN: какие адаптеры -->
                            <Border Style="{StaticResource SettingRow}" Margin="0,14,0,0" Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Какой VPN считается включённым" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding RuleDescription}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Margin="10,0,0,0"
                                            Content="Адаптеры" Command="{Binding ShowSectionCommand}" CommandParameter="Adapters" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== Подключения лаунчера ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Connections}">
                            <TextBlock Text="Подключения лаунчера" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Серверы, через которые лаунчер может вести приложения. Какое использовать, выбирается в разделе «Подключение» или в настройках приложения." />
                            <ItemsControl ItemsSource="{Binding Connections}" ItemTemplate="{StaticResource ConnectionRowTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,4" Text="Пока нет ни одного подключения."
                                       Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="Добавить подключение" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" />
                            <Border Style="{StaticResource PageCard}" Padding="18,16">
                                <views:AddConnectionForm DataContext="{Binding AddConnection}" />
                            </Border>
                        </StackPanel>

                        <!-- ===== Адаптеры ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Adapters}">
                            <TextBlock Text="Когда VPN считается подключённым" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Для «Системного VPN»: маршрутом управляет ваша VPN-программа, а лаунчер следит, что она включена. Приложения выходят в интернет только через эти адаптеры." />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Любой VPN"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyVpn}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Один из"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyOfSelected}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Все"
                                                 IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AllOfSelected}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="4,8,0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Подойдёт любой активный VPN. Переключатели адаптеров ниже не используются." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RuleMode}" Value="AnyOfSelected">
                                                <Setter Property="Text" Value="Достаточно, чтобы был активен хотя бы один из включённых адаптеров." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RuleMode}" Value="AllOfSelected">
                                                <Setter Property="Text" Value="Должны быть активны все включённые адаптеры одновременно." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource WarnBox}" Margin="0,0,0,16"
                                    Visibility="{Binding NeedsAdapterSelection, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:GlyphIcon Grid.Column="0" Glyph="&#xE7BA;" Size="14" Foreground="{StaticResource Warn}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                               Text="Не включён ни один адаптер, поэтому VPN считается отключённым. Включите нужный VPN ниже." />
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Сетевые адаптеры" Style="{StaticResource SectionTitle}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RefreshAdaptersCommand}" ToolTip="Обновить список адаптеров">
                                    <!-- После нажатия значок делает оборот: видно, что список обновился -->
                                    <views:GlyphIcon Glyph="&#xE72C;" Size="12" RenderTransformOrigin="0.5,0.5">
                                        <views:GlyphIcon.RenderTransform>
                                            <RotateTransform />
                                        </views:GlyphIcon.RenderTransform>
                                        <views:GlyphIcon.Style>
                                            <Style TargetType="views:GlyphIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefreshingAdapters}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="RefreshSpin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                     From="0" To="360" Duration="0:0:0.6" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="RefreshSpin" />
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:GlyphIcon.Style>
                                    </views:GlyphIcon>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource AdapterRowTemplate}" />

                            <!-- Адаптеры, не похожие на VPN: свёрнуты, «Показать» раскрывает их сразу и без сохранения -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasOtherAdapters, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ДРУГИЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ExpanderToggle}" HorizontalAlignment="Right" IsChecked="{Binding ShowAllAdapters}">
                                        <TextBlock Text="{Binding OtherToggleText}" Margin="0,0,8,0" />
                                    </ToggleButton>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,10"
                                           Text="Не похожи на VPN. Включите нужный, если ваш VPN не распознался." />
                                <ItemsControl ItemsSource="{Binding OtherAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}"
                                              Visibility="{Binding ShowAllAdapters, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRemovedAdapters, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="УДАЛЁННЫЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ExpanderToggle}" HorizontalAlignment="Right" IsChecked="{Binding IsRemovedExpanded}">
                                        <TextBlock Text="{Binding RemovedToggleText}" Margin="0,0,8,0" />
                                    </ToggleButton>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,10"
                                           Text="Лаунчер уже видел их, но сейчас их нет в системе. Некоторые VPN создают адаптер только на время подключения." />
                                <ItemsControl ItemsSource="{Binding RemovedAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}"
                                              Visibility="{Binding IsRemovedExpanded, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== Защита ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Protection}">
                            <TextBlock Text="Защита" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Приложения запускаются только с VPN, и их трафик не уходит мимо него. Первые два параметра можно задать и для отдельного приложения в его настройках." />

                            <TextBlock Text="Приложения, открытые не из лаунчера" FontWeight="Bold" FontSize="14" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,8"
                                       Text="С ярлыка, из автозагрузки или другой программы. «Через лаунчер» действует для всех приложений, остальные варианты только для приложений через подключение лаунчера." />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="4">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Через лаунчер"
                                                 IsChecked="{Binding OutsideCopies, Converter={StaticResource EnumToBool}, ConverterParameter=Launcher}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Через VPN"
                                                 IsChecked="{Binding OutsideCopies, Converter={StaticResource EnumToBool}, ConverterParameter=Vpn}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Без интернета"
                                                 IsChecked="{Binding OutsideCopies, Converter={StaticResource EnumToBool}, ConverterParameter=Block}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Напрямую"
                                                 IsChecked="{Binding OutsideCopies, Converter={StaticResource EnumToBool}, ConverterParameter=Allow}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="4,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Их трафик идёт через подключение приложения, пока открыт лаунчер." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OutsideCopies}" Value="Launcher">
                                                <Setter Property="Text" Value="Лаунчер берёт их под контроль так же, как при запуске с плитки: с теми же условиями и защитой. Если запускать приложение сейчас нельзя, например без VPN, копия сразу закроется. Действует, пока открыт лаунчер." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OutsideCopies}" Value="Block">
                                                <Setter Property="Text" Value="У них нет интернета, пока открыт лаунчер." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OutsideCopies}" Value="Allow">
                                                <Setter Property="Text" Value="Их трафик идёт мимо VPN. Изредка так же может уйти и соединение приложения, открытого из лаунчера." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KillSwitchEnabled}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE7E8;" Size="14" Foreground="{StaticResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Закрывать при обрыве (Kill-Switch)" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="При обрыве VPN приложения закроются. Без этого они останутся открытыми без интернета, пока VPN не вернётся." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideDns}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource WarnSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE774;" Size="14" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Защита от утечки DNS" FontWeight="Bold" FontSize="14" />
                                                <Border Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Весь компьютер" Foreground="{StaticResource Warn}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="Провайдер не увидит, какие сайты открывают приложения." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,8,0,0" Command="{Binding ShowHideDnsInfoCommand}">
                                <TextBlock Text="Как это работает и на что влияет →" />
                            </Button>
                        </StackPanel>

                        <!-- ===== Исключения: общие для всех приложений через подключение лаунчера ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Exclusions}">
                            <TextBlock Text="Исключения" Style="{StaticResource SectionTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Эти сайты все приложения через подключение лаунчера откроют напрямую, мимо подключения: трафик к ним идёт как без VPN. По одному в строке, поддомены входят: kaspi.kz откроет и online.kaspi.kz. Под системным VPN маршрутом управляет ваша VPN-программа, и исключения не действуют." />
                            <TextBox Style="{StaticResource InputArea}" Tag="kaspi.kz&#x0a;gosuslugi.ru"
                                     Text="{Binding CommonDomainsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="4,8,0,0"
                                       Text="В настройках приложения, блок «Исключения», можно добавить к общим свои домены или задать список вместо общих. Пустой список «Вместо общих» значит, что у приложения всё идёт через подключение." />
                        </StackPanel>

                        <!-- ===== Окно и трей ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Window}">
                            <TextBlock Text="Действие при закрытии" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,14" />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="3">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Спрашивать"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Ask}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="В трей"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Tray}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Закрыть"
                                                 IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Exit}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Margin="4,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Text" Value="Каждый раз спрашивать, свернуть в трей или закрыть. Относится к кнопке «Закрыть» вверху окна, Alt+F4 и закрытию с панели задач." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HideBehavior}" Value="Tray">
                                                <Setter Property="Text" Value="Лаунчер уходит в трей и продолжает следить за приложениями. Закрыть его можно из меню значка в трее." />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HideBehavior}" Value="Exit">
                                                <Setter Property="Text" Value="Лаунчер закрывается. Запущенные приложения, которые без него остались бы без защиты, закроются тоже: лаунчер спросит." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="4,14,0,0"
                                       Text="Значок в трее показывает состояние: красный — есть приложения без защиты. В его меню можно завершить запущенные приложения." />

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                            <views:GlyphIcon Glyph="&#xE7E8;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Запускать вместе с Windows" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                       Text="После входа в Windows лаунчер сразу работает в трее. Приложения он сам не запускает." />
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <!-- ===== Журналы (UI-1): окна журналов — строки целиком; хранение и скрытие адресов — по «Применить», подробный журнал — сразу ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Log}">
                            <TextBlock Text="Журналы" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,14" />
                            <Button Style="{StaticResource SettingLinkRow}" Margin="0,0,0,8" Command="{Binding ShowLogCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE81C;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Журнал событий" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Запуски и закрытия приложений, обрывы подключений" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingLinkRow}" Margin="0,0,0,8" Command="{Binding ShowTechLogCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE9D9;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Технический журнал" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Подробности работы лаунчера, службы и подключений. Нужен для поиска ошибок" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource SettingLinkRow}" Margin="0,0,0,8" Command="{Binding ShowExportCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE896;" Size="14" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Выгрузить для анализа" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Все журналы за выбранное время в одном архиве" Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <TextBlock Text="Хранение" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,14,0,10" />
                            <TextBlock Text="Где хранить" Style="{StaticResource Caption}" Margin="4,0,0,6" />
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                <UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="В файлах на компьютере" GroupName="LogStorage"
                                                 IsChecked="{Binding LogsInFiles}" />
                                    <RadioButton Style="{StaticResource SegmentRadio}" Content="Только пока лаунчер открыт" GroupName="LogStorage"
                                                 IsChecked="{Binding LogsInMemory}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Margin="4,6,0,0" TextWrapping="Wrap"
                                       Text="Журналы удаляются при закрытии лаунчера. Если лаунчер упадет, сохранится только описание ошибки"
                                       Visibility="{Binding LogsInMemory, Converter={StaticResource BoolToVis}}" />

                            <Grid Margin="0,14,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Сколько хранить" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding LogUsageText}" Style="{StaticResource Caption}" />
                            </Grid>
                            <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4"
                                    IsEnabled="{Binding LogsInFiles}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <UniformGrid Columns="5">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="1 день"
                                                     IsChecked="{Binding LogRetentionDays, Converter={StaticResource EqualsToBool}, ConverterParameter=1}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="3 дня"
                                                     IsChecked="{Binding LogRetentionDays, Converter={StaticResource EqualsToBool}, ConverterParameter=3}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="7 дней"
                                                     IsChecked="{Binding LogRetentionDays, Converter={StaticResource EqualsToBool}, ConverterParameter=7}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="14 дней"
                                                     IsChecked="{Binding LogRetentionDays, Converter={StaticResource EqualsToBool}, ConverterParameter=14}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="30 дней"
                                                     IsChecked="{Binding LogRetentionDays, Converter={StaticResource EqualsToBool}, ConverterParameter=30}" />
                                </UniformGrid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" Margin="0,16,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideLogAddresses}">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Скрывать IP-адреса" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Margin="0,1,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Text" Value="Адреса записываются как есть. Скрыть их можно и при выгрузке" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HideLogAddresses}" Value="True">
                                                            <Setter Property="Text" Value="Вместо адресов в журналах будут метки вида ip4-pub-3f2a1c. Одинаковые адреса получают одинаковые метки, ошибки разбирать можно" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LogRemaskText}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0"
                                                   Visibility="{Binding IsRemasking, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Подробный журнал включается и выключается сразу этим переключателем; пока включен, рядом с названием метка «до 22:14» -->
                            <Border Style="{StaticResource SettingRow}" Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsDetailedLog}">
                                    <StackPanel Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Подробный журнал на 1 час" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                            <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDetailedLog, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DetailedLogText}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,1,0,0" TextWrapping="Wrap"
                                                   Text="Записывает больше деталей о соединениях. Включайте, когда повторяете ошибку. Включается сразу, через час выключится сам. Работающие приложения не прерываются" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,14,0,0" Command="{Binding DeleteAllLogsCommand}">
                                <TextBlock Text="Удалить все журналы" Foreground="{StaticResource Danger}" />
                            </Button>
                        </StackPanel>

                        <!-- ===== Обновления: состояние, действия, автоматическая проверка, способ загрузки ===== -->
                        <StackPanel Visibility="{Binding Section, Converter={StaticResource EnumToVis}, ConverterParameter=Updates}">
                            <!-- Версия и что происходит сейчас. Цвет строки состояния: синий — идёт работа или есть обновление, зелёный — последняя версия, красный — ошибка -->
                            <Border Padding="16,14" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SettingRow}">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UpdateTone}" Value="Danger">
                                                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Column="0" Grid.Row="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource CardBg}" VerticalAlignment="Top">
                                        <views:GlyphIcon Glyph="&#xE895;" Size="15" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstalledVersionText}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdateTone}" Value="Accent">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UpdateTone}" Value="Success">
                                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UpdateTone}" Value="Danger">
                                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding UpdateDetailText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Ход проверки, загрузки, закрытия приложений и установки: с процентами, если известен размер файла -->
                                    <ProgressBar Grid.Column="1" Grid.Row="1" Style="{StaticResource SlimProgress}" Margin="12,12,0,0"
                                                 Value="{Binding UpdateProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsUpdateProgressIndeterminate, Mode=OneWay}"
                                                 Visibility="{Binding IsUpdateProgressVisible, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="12,12,0,0">
                                        <Button Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="16,6" FontSize="12.5" Margin="0,0,8,0" Content="Отменить загрузку"
                                                Command="{Binding CancelUpdateDownloadCommand}"
                                                Visibility="{Binding IsCancelDownloadVisible, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="16,6" FontSize="12.5" Margin="0,0,8,0" Content="Обновить"
                                                Command="{Binding InstallUpdateCommand}" ToolTip="Скачать, если ещё не скачана, и установить новую версию: лаунчер закроется и откроется уже обновлённым"
                                                Visibility="{Binding IsInstallUpdateVisible, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="14,6" FontSize="12.5" Margin="0,0,8,0" Content="Проверить"
                                                Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding CanUseUpdates}"
                                                ToolTip="Проверить, есть ли новая версия" />
                                        <Button Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="14,6" FontSize="12.5" Content="Что нового"
                                                Command="{Binding ShowChangelogCommand}" IsEnabled="{Binding CanShowChangelog}"
                                                ToolTip="Описание выпуска с GitHub: новой версии или установленной, если обновления нет" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Перед установкой работают приложения -->
                            <Border Style="{StaticResource WarnBox}" Margin="0,10,0,0" Visibility="{Binding IsUpdateAppsPanelVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Работают приложения" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Warn}" />
                                    <TextBlock Text="{Binding UpdateAppsText}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding UpdateAppsHint}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="16,6" FontSize="12.5" Margin="0,0,8,0"
                                                Content="Закрыть приложения и обновить" Command="{Binding CloseAppsAndUpdateCommand}"
                                                Visibility="{Binding IsCloseAppsVisible, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource DangerButton}" MinHeight="32" Padding="16,6" FontSize="12.5" Margin="0,0,8,0"
                                                Content="Закрыть принудительно" Command="{Binding ForceCloseAppsCommand}"
                                                ToolTip="Завершить приложения, которые не закрылись. Несохранённые данные в них пропадут"
                                                Visibility="{Binding IsForceCloseAppsVisible, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="16,6" FontSize="12.5"
                                                Content="Не обновлять сейчас" Command="{Binding CancelUpdateInstallCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" Margin="0,16,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdate}">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="Автоматически проверять и скачивать обновления" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding UpdateLastCheckText}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Способ загрузки: скрыт, пока не раскрыт «Дополнительно» -->
                            <ToggleButton x:Name="UpdateAdvanced" Style="{StaticResource ExpanderToggle}" Margin="0,10,0,0">
                                <TextBlock Text="Дополнительно" />
                            </ToggleButton>
                            <!-- Подписи с отступом 12, как текст «Дополнительно» над ними -->
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=UpdateAdvanced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="КАК СКАЧИВАТЬ ОБНОВЛЕНИЯ" Style="{StaticResource GroupTitle}" Margin="12,0,0,8" />
                                <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Напрямую" GroupName="UpdateRoute"
                                                     IsChecked="{Binding UpdateDirect}" />
                                        <RadioButton Style="{StaticResource SegmentRadio}" Content="Через подключение лаунчера" GroupName="UpdateRoute"
                                                     IsChecked="{Binding UpdateViaConnection}" />
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" Margin="12,6,0,0"
                                           Text="Обычное соединение с GitHub, как у браузера. Подходит почти всегда"
                                           Visibility="{Binding UpdateDirect, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Visibility="{Binding UpdateViaConnection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Caption}" Margin="12,6,0,10"
                                               Text="Для сетей, где GitHub недоступен. Проверка и загрузка идут через выбранное подключение, даже если оно сейчас не запущено" />
                                    <ListBox Style="{StaticResource ChoiceList}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                             ItemTemplate="{StaticResource ConnectionChoiceTemplate}"
                                             ItemsSource="{Binding Connections}" SelectedValuePath="Id" SelectedValue="{Binding UpdateConnectionId}"
                                             Visibility="{Binding HasConnections, Converter={StaticResource BoolToVis}}" />
                                    <Border Style="{StaticResource SettingRow}" Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                       Text="Подключений пока нет. Добавьте ссылку или подписку от вашего VPN-сервиса." />
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="14,6" FontSize="12" Margin="10,0,0,0"
                                                    Content="Добавить подключение" Command="{Binding ShowSectionCommand}" CommandParameter="Connections" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== Применить / Отменить: только когда есть изменения ===================== -->
        <Border Grid.Row="2" Margin="20,12,20,14" Background="{StaticResource CardBg}" CornerRadius="22" Padding="20,10,10,10"
                Effect="{StaticResource SmallShadow}" Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Изменения вступят в силу после «Применить»" Foreground="{StaticResource Warn}"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="12,0,8,0" Content="Отменить"
                        Command="{Binding CancelSettingsCommand}" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="18,8" Content="Применить"
                        Command="{Binding ApplySettingsCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
