<UserControl x:Class="KillSwitchLauncher.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KillSwitchLauncher.Views">
    <!-- Мастер первого запуска (DataContext — WelcomeViewModel): подключение → проверка → приложения. -->
    <Border Margin="20,0,20,14" CornerRadius="28" Background="{StaticResource PanelBg}">
        <ScrollViewer Margin="0,10,6,10" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,24,30,30" MaxWidth="640">

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StepText}" Style="{StaticResource GroupTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Command="{Binding SkipCommand}"
                            ToolTip="Всё это можно настроить потом в настройках">
                        <TextBlock Text="Пропустить" />
                    </Button>
                </Grid>

                <!-- ===================== Шаг 1. Подключение ===================== -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Как приложения будут выходить в интернет" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,18"
                               Text="Вставьте ссылку на сервер или адрес подписки: их выдаёт ваш VPN-сервис. Лаунчер поведёт через него только ваши приложения, остальные программы будут работать как обычно." />
                    <Border Style="{StaticResource PageCard}">
                        <views:AddConnectionForm DataContext="{Binding AddConnection}" />
                    </Border>

                </StackPanel>

                <!-- ===================== Шаг 2. Проверка ===================== -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Проверка подключения" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,18"
                               Text="Лаунчер открывает маленькую страницу через сервер и узнаёт, каким адресом вас видят сайты." />

                    <Border Style="{StaticResource PageCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessGradient}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckOk}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerGradient}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Идёт проверка: крутится значок -->
                                    <views:GlyphIcon Glyph="&#xE895;" Size="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     RenderTransformOrigin="0.5,0.5" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                                        <views:GlyphIcon.RenderTransform>
                                            <RotateTransform />
                                        </views:GlyphIcon.RenderTransform>
                                        <views:GlyphIcon.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </views:GlyphIcon.Triggers>
                                    </views:GlyphIcon>
                                    <views:GlyphIcon Size="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding CheckOk, Converter={StaticResource NullToCollapsed}}">
                                        <views:GlyphIcon.Style>
                                            <Style TargetType="views:GlyphIcon">
                                                <Setter Property="Glyph" Value="&#xE711;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CheckOk}" Value="True">
                                                        <Setter Property="Glyph" Value="&#xE73E;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </views:GlyphIcon.Style>
                                    </views:GlyphIcon>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,2,0,0">
                                <TextBlock Text="{Binding CheckTitle}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CheckDetails}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Padding="18,8" Content="Назад" Command="{Binding BackCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,8,0" Content="Проверить ещё раз"
                                Command="{Binding RecheckCommand}" />
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Padding="22,8" Content="Дальше" Command="{Binding NextCommand}" />
                    </Grid>
                </StackPanel>

                <!-- ===================== Шаг 3. Приложения ===================== -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Какие приложения защищать" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,18"
                               Text="Отметьте программы из меню «Пуск». Другие можно добавить потом кнопкой «Добавить приложение» или перетащив .exe или ярлык в окно." />

                    <Border Style="{StaticResource PageCard}" Padding="8">
                        <!-- Список не выше прежних 340, плюс поле поиска над ним -->
                        <views:StartMenuList DataContext="{Binding AppList}" MaxHeight="388" />
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Padding="18,8" Content="Назад" Command="{Binding BackCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="22,8" Content="Готово" Command="{Binding FinishCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
