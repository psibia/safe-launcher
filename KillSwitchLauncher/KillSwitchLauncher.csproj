<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KillSwitchLauncher</AssemblyName>
    <RootNamespace>KillSwitchLauncher</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Product>Безопасный лаунчер</Product>
    <AssemblyTitle>Безопасный лаунчер</AssemblyTitle>
    <Version>2.3.7</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тестам (KillSwitchLauncher.Tests) нужны внутренние методы -->
    <InternalsVisibleTo Include="KillSwitchLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Технический журнал: формат, хранение, скрытие адресов (общая библиотека с службой) -->
    <ProjectReference Include="..\SafeLauncher.Logging\SafeLauncher.Logging.csproj" />
  </ItemGroup>

  <!-- Хеши ключей лицензии (Services\License.cs). Файла нет в GitHub: без него лаунчер не примет ни один ключ. -->
  <ItemGroup Condition="Exists('..\installer\license-hashes.txt')">
    <EmbeddedResource Include="..\installer\license-hashes.txt" LogicalName="license-hashes.txt" Visible="false" />
  </ItemGroup>
  <Target Name="WarnNoLicenseHashes" BeforeTargets="Build" Condition="!Exists('..\installer\license-hashes.txt')">
    <Warning Text="Нет installer\license-hashes.txt: в лаунчер не встроены хеши ключей лицензии, и он не примет ни один ключ." />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
