<Window x:Class="KillSwitchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KillSwitchLauncher.Views"
        Title="Безопасный лаунчер"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="1100" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <!-- Свой заголовок окна вместо системного: перетаскивается полоса высотой CaptionHeight сверху,
         края окна по-прежнему тянутся, работают Snap и двойной клик (развернуть). Кнопок три системных нет:
         вместо них «свернуть» и «в трей» справа вверху. Тонкая «стеклянная» полоска снизу сохраняет тень окна. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Сетка выравнивания: всё содержимое окна начинается и заканчивается в 40 px от краёв.
         Внутренняя панель шире (20 px), а плитки внутри неё снова стоят на линии 40 px. -->

    <Grid x:Name="RootGrid">
        <Grid x:Name="ContentRoot" Margin="0,36,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- шапка со сводкой -->
            <RowDefinition Height="Auto" />  <!-- предупреждение: включён ещё один VPN -->
            <RowDefinition Height="*" />     <!-- страница: приложения, настройки, приложение, мастер -->
            <RowDefinition Height="Auto" />  <!-- строка состояния -->
        </Grid.RowDefinitions>

        <!-- ===================== Шапка в одну строку =====================
             Логотип и название, сводка («Защищены 2 из 3») с выпадающим списком приложений, кнопки. -->
        <Grid Grid.Row="0" Margin="40,2,40,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource CardBg}"
                    Effect="{StaticResource SmallShadow}" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="24" Height="24"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Безопасный лаунчер" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

                <!-- Вторая строка: подпись, а при выключенном Kill-Switch — красная метка на её месте -->
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="Приложения выходят в интернет только под защитой" Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKillSwitchOff}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Kill-Switch в настройках, поэтому выключенное состояние подсвечиваем здесь -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Padding="9,2"
                            Background="{StaticResource Danger}" Cursor="Hand"
                            Visibility="{Binding IsKillSwitchOff, Converter={StaticResource BoolToVis}}"
                            ToolTip="При обрыве VPN приложения не будут закрыты. Включить можно в настройках.">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}" CommandParameter="Protection" />
                        </Border.InputBindings>
                        <TextBlock Text="Kill-Switch выключен" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Сводка: белая «таблетка» фиксированной ширины, по клику — состояние каждого приложения -->
            <ToggleButton x:Name="SummaryToggle" Grid.Column="2" Width="260" Height="44" Margin="0,0,12,0" Padding="5,4,14,4"
                          Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                          IsChecked="{Binding IsSummaryOpen}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=SummaryPopup, Converter={StaticResource InverseBool}}">
                <Grid Width="238">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SubtleBg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SummaryTone}" Value="Ok">
                                        <Setter Property="Background" Value="{StaticResource SuccessGradient}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryTone}" Value="Warn">
                                        <Setter Property="Background" Value="{StaticResource Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SummaryTone}" Value="Danger">
                                        <Setter Property="Background" Value="{StaticResource DangerGradient}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <views:GlyphIcon Size="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <views:GlyphIcon.Style>
                                <Style TargetType="views:GlyphIcon">
                                    <Setter Property="Glyph" Value="&#xE72E;" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryTone}" Value="Idle">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SummaryTone}" Value="Warn">
                                            <Setter Property="Glyph" Value="&#xE916;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SummaryTone}" Value="Danger">
                                            <Setter Property="Glyph" Value="&#xE785;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:GlyphIcon.Style>
                        </views:GlyphIcon>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryTitle}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding SummarySubtitle}" FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMuted}" />
                </Grid>
            </ToggleButton>

            <Popup x:Name="SummaryPopup" PlacementTarget="{Binding ElementName=SummaryToggle}" Placement="Bottom" HorizontalOffset="-66"
                   VerticalOffset="4" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsSummaryOpen}">
                <Border Margin="16,4,16,24" Width="360" Background="{StaticResource CardBg}" CornerRadius="20" Padding="18,16"
                        Effect="{StaticResource PopupShadow}">
                    <StackPanel>
                        <!-- Системный VPN: включён ли и какой -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVpnConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" FontSize="12.5">
                                    <Run Text="Системный VPN: " />
                                    <Run Text="{Binding VpnStatusText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding VpnSubtitle}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource WarnBox}" Margin="0,12,0,0" Padding="12,10"
                                Visibility="{Binding HasOtherVpnWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding OtherVpnWarning}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <Border Height="1" Background="{StaticResource Divider}" Margin="0,14,0,12" />
                        <TextBlock Text="ПРИЛОЖЕНИЯ" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="Приложений пока нет" Style="{StaticResource Caption}"
                                   Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#D6D6DE" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Protected">
                                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                                <Setter Property="Fill" Value="{StaticResource Warn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unprotected">
                                                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid>
                    <ToggleButton Style="{StaticResource GhostButton}" Padding="20,10" IsChecked="{Binding IsSettingsOpen}" Content="Настройки" />

                    <!-- Найдено обновление: кружок с цифрой на кнопке «Настройки» -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Width="20" Height="20"
                            CornerRadius="10" Background="{StaticResource AccentGradient}" BorderBrush="{StaticResource WindowBg}"
                            BorderThickness="2" IsHitTestVisible="False"
                            Visibility="{Binding IsUpdateFound, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                </Grid>

                <Button Style="{StaticResource PrimaryButton}" Padding="18,10" Margin="12,0,0,0" Command="{Binding AddAppCommand}"
                        ToolTip="Выбрать программы из меню «Пуск» или в проводнике. Можно и перетащить .exe или ярлык в окно."
                        Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <views:GlyphIcon Glyph="&#xE710;" Size="12" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="Добавить приложение" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Включён ещё один VPN на весь компьютер ===================== -->
        <Border Grid.Row="1" Style="{StaticResource WarnBox}" Margin="20,0,20,12" Padding="16,10"
                Visibility="{Binding HasOtherVpnWarning, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:GlyphIcon Grid.Column="0" Glyph="&#xE7BA;" Size="14" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding OtherVpnWarning}" Foreground="{StaticResource Warn}" FontSize="12.5" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===================== Страница «Приложения» ===================== -->
        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="28" Background="{StaticResource PanelBg}"
                Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVis}}">
            <Grid x:Name="HomeArea" Background="Transparent">
                <!-- Плитки. Отступы стоят внутри прокрутки, чтобы тени плиток не обрезались. -->
                <ScrollViewer x:Name="HomeScroll" Margin="0,10,6,10" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HomeTiles" ItemsSource="{Binding Apps}" Margin="10,0,4,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:AnimatedWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Style="{StaticResource TileButton}" Height="178" Command="{Binding LaunchCommand}" ToolTip="{Binding ToolTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource AppContextMenu}">
                                            <MenuItem Style="{StaticResource MenuHeaderItem}" Header="{Binding Name}" />
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Запустить" Command="{Binding LaunchCommand}" FontWeight="SemiBold">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Запустить без сети" Command="{Binding LaunchOfflineCommand}"
                                                      Visibility="{Binding IsOfflineMode, Converter={StaticResource InverseBoolToVis}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE709;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Перезапустить под защитой" Command="{Binding RestartProtectedCommand}"
                                                      Visibility="{Binding IsUnprotected, Converter={StaticResource BoolToVis}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Завершить все процессы" Command="{Binding KillCommand}"
                                                      IsEnabled="{Binding IsRunning}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Настройки приложения" Command="{Binding OpenSettingsCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Открыть расположение файла" Command="{Binding OpenLocationCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Style="{StaticResource MenuSeparator}" />
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="{Binding DnsToggleText}" Command="{Binding ToggleDnsCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Открыть журнал DNS" Command="{Binding OpenDnsJournalCommand}"
                                                      IsEnabled="{Binding CanOpenDnsJournal}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Style="{StaticResource MenuSeparator}" />
                                            <MenuItem Style="{StaticResource DangerMenuItem}" Header="Убрать из лаунчера" Command="{Binding RemoveCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <!-- Зона иконки фиксированной высоты: иконки всех плиток стоят на одной линии,
                                         даже если название занимает две строки -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="108" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Кольцо состояния: зелёное — работает под защитой, жёлтое — ждёт сеть,
                                             серое с меткой — работает без защиты -->
                                        <Ellipse Grid.Row="0" Width="86" Height="86" Margin="0,15,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                 StrokeThickness="2.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Stroke" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Protected">
                                                            <Setter Property="Stroke" Value="{StaticResource SuccessGradient}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                            <Setter Property="Stroke" Value="{StaticResource Warn}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unprotected">
                                                            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Серый круг под иконкой, как аватары на референсе -->
                                        <Border x:Name="IconCircle" Grid.Row="0" Width="76" Height="76" CornerRadius="38" Margin="0,20,0,0"
                                                Background="{StaticResource RowBg}" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid>
                                                <!-- Иконка из .exe -->
                                                <Image Source="{Binding Icon}" Width="44" Height="44"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <!-- Иконка по умолчанию -->
                                                <views:GlyphIcon Glyph="&#xE7C3;" Size="26"
                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <views:GlyphIcon.Style>
                                                        <Style TargetType="views:GlyphIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </views:GlyphIcon.Style>
                                                </views:GlyphIcon>
                                            </Grid>
                                        </Border>

                                        <!-- Значок: журнал DNS включён -->
                                        <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                                Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="6,2,7,2"
                                                Visibility="{Binding IsDnsTracking, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding DnsToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Accent}"
                                                           VerticalAlignment="Center" Margin="0,1,4,0" />
                                                <TextBlock Text="DNS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Индикатор: запущено и под контролем Kill-Switch -->
                                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                Background="{StaticResource SuccessSoft}" CornerRadius="9" Padding="7,2,8,2"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding RunningToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                <TextBlock Text="{Binding RunningCount}" Foreground="{StaticResource Success}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Метка «без защиты» на кольце -->
                                        <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0"
                                                Background="{StaticResource Danger}" CornerRadius="8" Padding="7,1,7,2"
                                                Visibility="{Binding Status, Converter={StaticResource EnumToVis}, ConverterParameter=Unprotected}">
                                            <TextBlock Text="без защиты" Foreground="White" FontSize="10.5" FontWeight="Bold" />
                                        </Border>
                                        <!-- «Подключаю…», «Ждёт сеть» — тоже на кольце -->
                                        <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0"
                                                Background="{StaticResource WarnSoft}" CornerRadius="8" Padding="7,1,7,2"
                                                Visibility="{Binding Status, Converter={StaticResource EnumToVis}, ConverterParameter=Waiting}">
                                            <TextBlock Text="ждёт сеть" Foreground="{StaticResource Warn}" FontSize="10.5" FontWeight="Bold" />
                                        </Border>

                                        <!-- Название снизу по центру, не больше двух строк; под ним — подключение, если оно не общее -->
                                        <StackPanel Grid.Row="1" Margin="12,0,12,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34" />
                                            <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSubtitleWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconCircle" Property="Background" Value="{StaticResource AccentSoft}" />
                                    </Trigger>
                                    <!-- Плитку перетаскивают: на её месте пустая ячейка, за курсором идёт её копия -->
                                    <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                        <Setter TargetName="Tile" Property="Opacity" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Пустой список -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                            Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource CardBg}" Effect="{StaticResource SoftShadow}">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Здесь появятся ваши приложения" FontSize="18" FontWeight="Bold" Margin="0,20,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="Нажмите «Добавить приложение» или перетащите сюда программу (.exe) или её ярлык"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Остальные страницы ===================== -->
        <views:SettingsPage Grid.Row="2" Grid.RowSpan="2" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}" />
        <views:AppSettingsPage Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding AppPage}"
                               Visibility="{Binding DataContext.IsAppPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        <views:WelcomePage Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding Welcome}"
                           Visibility="{Binding DataContext.IsWelcomePage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        <views:AddAppsPage Grid.Row="2" Grid.RowSpan="2" DataContext="{Binding AddApps}"
                           Visibility="{Binding DataContext.IsAddAppsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <!-- ===================== Строка состояния (только на странице приложений) ===================== -->
        <Grid Grid.Row="3" Margin="40,12,40,14" Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding RunningSummary}" Foreground="{StaticResource TextMuted}" FontSize="12" />
            </StackPanel>
        </Grid>

        </Grid>

        <!-- ===================== Кнопки заголовка: свернуть и закрыть =====================
             Лежат поверх всего, даже открытых настроек, и кликабельны внутри полосы заголовка.
             «Закрыть» выполняет «Действие при закрытии» из настроек (спросить, в трей или закрыть). -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClicked" ToolTip="Свернуть">
                <Path Data="M0,0.5 H10" Width="10" Height="1" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="OnHideClicked" ToolTip="Закрыть">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>

        <!-- ===================== Затемнение под диалогами ===================== -->
        <Border x:Name="DimOverlay" Background="#33181826" Visibility="Collapsed" />

        <!-- ===================== Уведомление: белая «таблетка» с градиентным кругом ===================== -->
        <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" MinWidth="320" MaxWidth="480" CornerRadius="28" Padding="8,8,26,8"
                Background="{StaticResource CardBg}" Effect="{StaticResource PopupShadow}"
                Visibility="Collapsed" Opacity="0" Cursor="Hand" MouseLeftButtonUp="OnToastClicked"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="-40" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource SuccessGradient}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Danger">
                                    <Setter Property="Background" Value="{StaticResource DangerGradient}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:GlyphIcon Glyph="{Binding Glyph}" Size="15" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Действие уведомления, например «Выгрузить» после отметки проблемы -->
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Margin="14,0,-12,0"
                        VerticalAlignment="Center" Content="{Binding ActionText}" Click="OnToastActionClicked"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>
    </Grid>
</Window>
