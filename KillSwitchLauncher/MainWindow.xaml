<Window x:Class="KillSwitchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KillSwitchLauncher.Converters"
        xmlns:views="clr-namespace:KillSwitchLauncher.Views"
        Title="Безопасный лаунчер"
        Icon="pack://application:,,,/Assets/logo.ico"
        Width="1100" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Свой заголовок окна вместо системного: перетаскивается полоса высотой CaptionHeight сверху,
         края окна по-прежнему тянутся, работают Snap и двойной клик (развернуть). Кнопок три системных нет:
         вместо них «свернуть» и «в трей» справа вверху. Тонкая «стеклянная» полоска снизу сохраняет тень окна. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Сетка выравнивания: всё содержимое окна начинается и заканчивается в 40 px от краёв.
         Внутренняя панель шире (20 px), а плитки внутри неё снова стоят на линии 40 px. -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Подпись группы адаптеров: мелкие прописные -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Строка настроек: серая скруглённая подложка -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RowBg}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- Строка адаптера: переключатель, а у удалённых ещё и кнопка «забыть» -->
        <DataTemplate x:Key="AdapterRowTemplate">
            <Border Style="{StaticResource SettingRow}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding DataContext.IsAdapterSelectionEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <views:GlyphIcon Glyph="&#xE72E;" Size="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <views:GlyphIcon.Style>
                                        <Style TargetType="views:GlyphIcon">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </views:GlyphIcon.Style>
                                </views:GlyphIcon>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Product}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11.5" Margin="0,1,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding StateText, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                    <Run Text=" · " Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding Details, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </CheckBox>

                    <!-- «Забыть» — только у удалённых адаптеров -->
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ForgetCommand}" ToolTip="Забыть этот адаптер">
                        <Button.Visibility>
                            <Binding Path="ForgetCommand">
                                <Binding.Converter>
                                    <conv:NullToCollapsedConverter />
                                </Binding.Converter>
                            </Binding>
                        </Button.Visibility>
                        <views:GlyphIcon Glyph="&#xE74D;" Size="12" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Всё содержимое страницы; пока открыты настройки, оно размыто. Сверху — место под заголовок окна. -->
        <Grid x:Name="ContentRoot" Margin="0,36,0,0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRulesPanelOpen}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="10" KernelType="Gaussian" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- шапка + статус VPN -->
            <RowDefinition Height="Auto" />  <!-- (свободно) -->
            <RowDefinition Height="*" />     <!-- внутренняя панель -->
            <RowDefinition Height="Auto" />  <!-- строка состояния -->
        </Grid.RowDefinitions>

        <!-- ===================== 1. Компактная шапка в одну строку =====================
             Логотип и название, статус VPN фиксированной ширины (не меняет размер при смене текста), кнопки. -->
        <Grid Grid.Row="0" Margin="40,2,40,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource CardBg}"
                    Effect="{StaticResource SmallShadow}" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="24" Height="24"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Безопасный лаунчер" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

                <!-- Вторая строка: подпись, а при выключенном Kill-Switch — красная метка на её месте -->
                <Grid Margin="0,2,0,0">
                    <TextBlock Text="Приложения запускаются только при активном VPN" Foreground="{StaticResource TextMuted}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKillSwitchOff}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Kill-Switch в настройках, поэтому выключенное состояние подсвечиваем здесь -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="9" Padding="9,2"
                            Background="{StaticResource Danger}" Cursor="Hand"
                            Visibility="{Binding IsKillSwitchOff, Converter={StaticResource BoolToVis}}"
                            ToolTip="При обрыве VPN приложения не будут закрыты. Включить можно в настройках.">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}" />
                        </Border.InputBindings>
                        <TextBlock Text="Kill-Switch выключен" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Статус VPN: компактная белая «таблетка» фиксированной ширины -->
            <Border Grid.Column="2" Width="168" Height="40" Margin="0,0,12,0" CornerRadius="20" Background="{StaticResource CardBg}"
                    Padding="4,4,16,4" VerticalAlignment="Center" Effect="{StaticResource SmallShadow}"
                    ToolTip="{Binding VpnDetailsText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="32" Height="32">
                        <!-- Пульсирующее кольцо -->
                        <Ellipse StrokeThickness="1.5">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="{StaticResource DangerGradient}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVpnConnected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource SuccessGradient}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0.15" Duration="0:0:1.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Width="25" Height="25">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerGradient}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVpnConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessGradient}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <views:GlyphIcon Size="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <views:GlyphIcon.Style>
                                <Style TargetType="views:GlyphIcon">
                                    <Setter Property="Glyph" Value="&#xE785;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVpnConnected}" Value="True">
                                            <Setter Property="Glyph" Value="&#xE72E;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </views:GlyphIcon.Style>
                        </views:GlyphIcon>
                    </Grid>

                    <!-- Только суть; подробности — во всплывающей подсказке -->
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding VpnStatusText}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,12,0">
                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource GhostButton}" Padding="20,10"
                                  IsChecked="{Binding IsRulesPanelOpen}" Content="Настройки" />

                    <!-- Найдено обновление: кружок с цифрой на кнопке «Настройки» -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Width="20" Height="20"
                            CornerRadius="10" Background="{StaticResource AccentGradient}" BorderBrush="{StaticResource WindowBg}"
                            BorderThickness="2" IsHitTestVisible="False"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="1" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                </Grid>

                <Button Style="{StaticResource PrimaryButton}" Padding="18,10" Command="{Binding AddAppCommand}">
                    <StackPanel Orientation="Horizontal">
                        <views:GlyphIcon Glyph="&#xE710;" Size="12" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="Добавить приложение" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== 3. Внутренняя панель ===================== -->
        <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="28" Background="{StaticResource PanelBg}">
            <Grid>

                <!-- Плитки. Отступы стоят внутри прокрутки, чтобы тени плиток не обрезались. -->
                <ScrollViewer Grid.Column="0" Margin="0,10,6,10" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Apps}" Margin="10,0,4,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="Tile" Style="{StaticResource TileButton}" Command="{Binding LaunchCommand}" ToolTip="{Binding ToolTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource AppContextMenu}">
                                            <MenuItem Style="{StaticResource MenuHeaderItem}" Header="{Binding Name}" />
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Запустить" Command="{Binding LaunchCommand}" FontWeight="SemiBold">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Style="{StaticResource AppMenuItem}" Header="Открыть расположение файла" Command="{Binding OpenLocationCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Style="{StaticResource MenuSeparator}" />
                                            <MenuItem Style="{StaticResource DangerMenuItem}" Header="Убрать из лаунчера" Command="{Binding RemoveCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <!-- Зона иконки фиксированной высоты: иконки всех плиток стоят на одной линии,
                                         даже если название занимает две строки -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="108" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Серый круг под иконкой, как аватары на референсе -->
                                        <Border x:Name="IconCircle" Grid.Row="0" Width="76" Height="76" CornerRadius="38" Margin="0,20,0,0"
                                                Background="{StaticResource RowBg}" HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <Grid>
                                                <!-- Иконка из .exe -->
                                                <Image Source="{Binding Icon}" Width="44" Height="44"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <!-- Иконка по умолчанию -->
                                                <views:GlyphIcon Glyph="&#xE7C3;" Size="26"
                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <views:GlyphIcon.Style>
                                                        <Style TargetType="views:GlyphIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </views:GlyphIcon.Style>
                                                </views:GlyphIcon>
                                            </Grid>
                                        </Border>

                                        <!-- Индикатор: запущено и под контролем Kill-Switch -->
                                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                Background="{StaticResource SuccessSoft}" CornerRadius="9" Padding="7,2,8,2"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding RunningToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,1,5,0" />
                                                <TextBlock Text="{Binding RunningCount}" Foreground="{StaticResource Success}" FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Название снизу по центру, не больше двух строк -->
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="12,0,12,0" VerticalAlignment="Top"
                                                   HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconCircle" Property="Background" Value="{StaticResource AccentSoft}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Пустой список -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                            Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource CardBg}" Effect="{StaticResource SoftShadow}">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Здесь появятся ваши приложения" FontSize="18" FontWeight="Bold" Margin="0,20,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="Нажмите «Добавить приложение» и выберите .exe или ярлык .lnk"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ===================== 4. Строка состояния ===================== -->
        <Grid Grid.Row="3" Margin="40,12,40,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock Text="{Binding RunningSummary}" Foreground="{StaticResource TextMuted}" FontSize="12" />
            </StackPanel>
        </Grid>

        </Grid>

        <!-- Затемнение под панелью настроек; клик по нему закрывает панель -->
        <Border x:Name="SettingsScrim" Background="#26181826"
                Visibility="{Binding IsRulesPanelOpen, Converter={StaticResource BoolToVis}}" />

        <!-- ===================== Панель настроек: выезжает справа на всю высоту окна =====================
             Перекрывает шапку (и статус VPN), фон под ней размыт. Изменения вступают в силу только по «Применить». -->
        <Border x:Name="SettingsCard" HorizontalAlignment="Right" Width="400" Margin="0,36,12,12"
                Background="{StaticResource CardBg}" CornerRadius="24" Effect="{StaticResource PopupShadow}"
                Visibility="{Binding IsRulesPanelOpen, Converter={StaticResource BoolToVis}}">
            <Border.RenderTransform>
                <TranslateTransform X="0" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRulesPanelOpen}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="420" To="0" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Отступ у прокрутки, чтобы полоса не заходила на скруглённые углы -->
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Margin="0,14,4,0" Focusable="False"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,8,18,12">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Настройки" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding ToggleRulesPanelCommand}"
                                    ToolTip="Закрыть настройки">
                                <views:GlyphIcon Glyph="&#xE711;" Size="11" />
                            </Button>
                        </Grid>

                        <!-- ===== Защита ===== -->
                        <TextBlock Text="Защита" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding KillSwitchEnabled}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoft}" VerticalAlignment="Center">
                                        <views:GlyphIcon Glyph="&#xE7E8;" Size="14" Foreground="{StaticResource Danger}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Kill-Switch" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="Закрывать приложения при обрыве VPN" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </CheckBox>
                        </Border>
                        <TextBlock Text="Выключение потребует подтверждения." Style="{StaticResource Caption}" Margin="4,8,0,24" />

                        <!-- ===== Правила VPN ===== -->
                        <TextBlock Text="Когда VPN считается подключённым" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Rule" Content="Любой VPN"
                                             IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyVpn}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Rule" Content="Один из"
                                             IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AnyOfSelected}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Rule" Content="Все"
                                             IsChecked="{Binding RuleMode, Converter={StaticResource EnumToBool}, ConverterParameter=AllOfSelected}" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Margin="4,8,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Text" Value="Подойдёт любой активный VPN. Переключатели адаптеров ниже не используются." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RuleMode}" Value="AnyOfSelected">
                                            <Setter Property="Text" Value="Достаточно, чтобы был активен хотя бы один из включённых адаптеров." />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RuleMode}" Value="AllOfSelected">
                                            <Setter Property="Text" Value="Должны быть активны все включённые адаптеры одновременно." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Предупреждение: нужен выбор адаптеров, а ничего не включено -->
                        <Border Background="{StaticResource WarnSoft}" CornerRadius="16" Padding="14,12" Margin="0,0,0,16"
                                Visibility="{Binding NeedsAdapterSelection, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <views:GlyphIcon Grid.Column="0" Glyph="&#xE7BA;" Size="14" Foreground="{StaticResource Warn}"
                                                 VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12"
                                           Text="Не включён ни один адаптер, поэтому VPN считается отключённым. Включите нужный VPN ниже." />
                            </Grid>
                        </Border>

                        <!-- ===== Адаптеры ===== -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Сетевые адаптеры" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding RefreshAdaptersCommand}"
                                    ToolTip="Обновить список адаптеров">
                                <views:GlyphIcon Glyph="&#xE72C;" Size="12" />
                            </Button>
                        </Grid>

                        <!-- Фильтр списка: применяется сразу и не сохраняется, при запуске всегда выключен -->
                        <Border Style="{StaticResource SettingRow}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAllAdapters}">
                                <StackPanel>
                                    <TextBlock Text="Показывать все адаптеры" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Если ваш VPN не распознался автоматически" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- VPN и выбранные адаптеры: эта группа не меняется при «Показывать все адаптеры» -->
                        <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,8,0,0"
                                      ItemTemplate="{StaticResource AdapterRowTemplate}" />

                        <!-- ===== Другие адаптеры: появляются отдельной группой ниже ===== -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowOtherGroup, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ДРУГИЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" />
                            <TextBlock Text="Не похожи на VPN. Включите нужный, если ваш VPN не распознался." Style="{StaticResource Caption}" Margin="4,2,0,10" />
                            <ItemsControl ItemsSource="{Binding OtherAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}" />
                        </StackPanel>

                        <!-- ===== Удалённые адаптеры: отдельная свёрнутая группа ===== -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRemovedAdapters, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="УДАЛЁННЫЕ АДАПТЕРЫ" Style="{StaticResource GroupTitle}" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource ExpanderToggle}" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsRemovedExpanded}">
                                    <TextBlock Text="{Binding RemovedToggleText}" Margin="0,0,8,0" />
                                </ToggleButton>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,10"
                                       Text="Лаунчер уже видел их, но сейчас их нет в системе. Некоторые VPN создают адаптер только на время подключения." />
                            <ItemsControl ItemsSource="{Binding RemovedAdapters}" ItemTemplate="{StaticResource AdapterRowTemplate}"
                                          Visibility="{Binding IsRemovedExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- ===== Действие при закрытии (кнопка «Закрыть», Alt+F4): спросить, в трей или закрыть ===== -->
                        <TextBlock Text="Действие при закрытии" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                        <Border Background="{StaticResource SubtleBg}" CornerRadius="14" Padding="4">
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Hide" Content="Спрашивать"
                                             IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Ask}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Hide" Content="В трей"
                                             IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Tray}" />
                                <RadioButton Style="{StaticResource SegmentRadio}" GroupName="Hide" Content="Закрыть"
                                             IsChecked="{Binding HideBehavior, Converter={StaticResource EnumToBool}, ConverterParameter=Exit}" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Margin="4,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Text" Value="Каждый раз спрашивать, свернуть в трей или закрыть. Относится к кнопке «Закрыть» вверху окна, Alt+F4 и закрытию с панели задач." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HideBehavior}" Value="Tray">
                                            <Setter Property="Text" Value="Лаунчер уходит в трей и продолжает следить за VPN. Закрыть его можно из меню значка в трее." />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HideBehavior}" Value="Exit">
                                            <Setter Property="Text" Value="Лаунчер закрывается. При включённом Kill-Switch запущенные приложения тоже закроются." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- ===== Журнал событий ===== -->
                        <TextBlock Text="Журнал" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                        <Border Style="{StaticResource SettingRow}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                    <views:GlyphIcon Glyph="&#xE81C;" Size="14" Foreground="{StaticResource Accent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Журнал событий" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="VPN, запуски и закрытия приложений" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12"
                                        VerticalAlignment="Center" Content="Открыть" Command="{Binding ShowLogCommand}" />
                            </Grid>
                        </Border>

                        <!-- ===== О программе: версия и обновления (компактно, одной строкой) =====
                             Когда найдено обновление, строка подсвечена, а панель при открытии прокручивается сюда. -->
                        <TextBlock Text="О программе" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
                        <Border x:Name="AboutRow" Padding="14,10" BorderThickness="1.5">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SettingRow}">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                    <views:GlyphIcon Glyph="&#xE895;" Size="14" Foreground="{StaticResource Accent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersionText}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UpdateStatusText}" Margin="0,1,0,0" ToolTip="{Binding UpdateStatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12"
                                        Margin="0,0,6,0" VerticalAlignment="Center" Content="Что нового"
                                        Command="{Binding ShowChangelogCommand}" IsEnabled="{Binding CanUseUpdates}"
                                        ToolTip="Описание изменений: установленной версии или доступного обновления" />
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Проверить"
                                            Command="{Binding UpdateActionCommand}" IsEnabled="{Binding CanUseUpdates}"
                                            Visibility="{Binding IsUpdateNotAvailable, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Проверить обновления" />
                                    <Button Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="12,6" FontSize="12" Content="Обновить"
                                            Command="{Binding UpdateActionCommand}" IsEnabled="{Binding CanUseUpdates}"
                                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Скачать и установить обновление" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Применить / Отменить ===== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="22,12,22,20">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,10" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Text" Value="Изменений нет" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                            <Setter Property="Text" Value="Изменения вступят в силу после «Применить»" />
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Content="Отменить"
                                    Command="{Binding CancelSettingsCommand}" IsEnabled="{Binding HasPendingChanges}" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Content="Применить"
                                    Command="{Binding ApplySettingsCommand}" IsEnabled="{Binding HasPendingChanges}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Кнопки заголовка: свернуть и закрыть =====================
             Лежат поверх всего, даже открытых настроек, и кликабельны внутри полосы заголовка.
             «Закрыть» выполняет «Действие при закрытии» из настроек (спросить, в трей или закрыть). -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClicked" ToolTip="Свернуть">
                <Path Data="M0,0.5 H10" Width="10" Height="1" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="OnHideClicked" ToolTip="Закрыть">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>

        <!-- ===================== Затемнение под диалогами ===================== -->
        <Border x:Name="DimOverlay" Background="#33181826" Visibility="Collapsed" />

        <!-- ===================== Уведомление: белая «таблетка» с градиентным кругом ===================== -->
        <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" MinWidth="320" MaxWidth="480" CornerRadius="28" Padding="8,8,26,8"
                Background="{StaticResource CardBg}" Effect="{StaticResource PopupShadow}"
                Visibility="Collapsed" Opacity="0" Cursor="Hand" MouseLeftButtonUp="OnToastClicked"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="-40" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource SuccessGradient}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Danger">
                                    <Setter Property="Background" Value="{StaticResource DangerGradient}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:GlyphIcon Glyph="{Binding Glyph}" Size="15" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
